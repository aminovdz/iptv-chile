---
import { Play, Sparkles, CheckCircle2, ShieldCheck, Zap, Award, ArrowRight, Tv, Wifi, MessageSquare } from 'lucide-astro';

interface Props {
  headline?: string;
  subheadline?: string;
  city?: string;
  badge?: string;
}

const {
  city,
  badge = '🇨🇱 El Proveedor IPTV #1 en Chile para 2026',
  headline = city 
    ? `Mejor IPTV Chile en ${city} — Transmisión 4K y Servidores Anti-Cortes` 
    : 'Chile IPTV — Canales Chilenos e Internacionales en Vivo y Calidad 4K',
  subheadline = city
    ? `Disfruta del servicio chile iptv con conexión ultrarrápida optimizada para hogares de ${city}. Mira todos los partidos de la Liga Chilena, Copa Libertadores y señales nacionales en alta definición sin pagar las costosas tarifas de VTR o Movistar.`
    : 'Accede a la mejor experiencia de chile iptv y olvídate de pagar más de $60.000 al mes por televisión por cable. Con iptv chile obtienes transmisión ultraestable en 4K y FHD, fútbol en vivo en ultra alta definición a 60 FPS y señales nacionales e internacionales en Smart TV, Firestick y celulares.'
} = Astro.props;
---

<section class="relative pt-8 pb-20 lg:pt-16 lg:pb-32 overflow-hidden">
  <!-- Dynamic Background Lighting -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-red-600/15 via-blue-600/10 to-transparent rounded-full blur-[140px]"></div>
    <div class="absolute -top-24 right-10 w-96 h-96 bg-red-600/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Top Trust Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-red-500/30 text-slate-200 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md shadow-sm hover:border-red-500/50 transition-colors">
        <span class="flex h-2 w-2 rounded-full bg-red-500 animate-ping"></span>
        <Award class="w-4 h-4 text-red-400" />
        <span>{badge}</span>
      </div>

      <!-- Main H1 Title (Primary Keyword Placement) -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.12] mb-6">
        <span class="text-white">{headline.split('—')[0]}</span>
        {headline.includes('—') && (
          <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-400 to-blue-400">
            — {headline.split('—')[1]}
          </span>
        )}
      </h1>

      <!-- Opening Paragraph with Keyword Integration -->
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-8 max-w-3xl mx-auto">
        {subheadline}
      </p>

      <!-- Trust Badges Bar -->
      <div class="flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs sm:text-sm text-slate-300 font-medium mb-10">
        <span class="flex items-center gap-1.5 text-slate-200">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>99.9% Disponibilidad de Servidor</span>
        </span>
        <span class="flex items-center gap-1.5 text-slate-200">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Calidad 4K UHD & 60 FPS Real</span>
        </span>
        <span class="flex items-center gap-1.5 text-slate-200">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>🎁 App Premium Gratis (Plan 12 Meses)</span>
        </span>
        <span class="flex items-center gap-1.5 text-slate-200">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Sin Contratos de Permanencia</span>
        </span>
        <span class="flex items-center gap-1.5 text-slate-200">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>WebPay, Mercado Pago y Transferencia</span>
        </span>
      </div>

      <!-- High-Conversion Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a 
          href="#precios" 
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-red-600 via-red-700 to-red-600 hover:from-red-500 hover:to-red-600 text-white font-extrabold text-base sm:text-lg shadow-xl shadow-red-600/30 transition-all duration-300 hover:scale-105 flex items-center justify-center gap-3 border border-red-400/40"
        >
          <Sparkles class="w-5 h-5 text-yellow-300" />
          <span>Ver Planes — desde $5 USD</span>
          <ArrowRight class="w-5 h-5" />
        </a>

        <a 
          href="https://wa.me/18036582620?text=Hola!%20Me%20gustaría%20solicitar%20mi%20prueba%20gratuita%20de%2024%20horas%20para%20probar%20iptv%20CHILE." 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-[#0D0D14]/80 hover:bg-[#131320] text-slate-100 font-bold text-base sm:text-lg border border-white/10 transition-all duration-200 flex items-center justify-center gap-3 backdrop-blur-xl hover:border-emerald-500/40 hover:text-emerald-300"
        >
          <MessageSquare class="w-5 h-5 text-emerald-400" />
          <span>Solicitar Prueba Gratis 24h</span>
        </a>
      </div>

      <!-- Channel Categories & Chilean Stations Strip -->
      <div class="pt-6 border-t border-white/10 max-w-4xl mx-auto">
        <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-4">
          Transmisión en Vivo de Señales Chilenas & Torneos Deportivos:
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
          {[
            'Canales Nacionales HD',
            'Fútbol Chileno en Vivo',
            'Señales Deportivas 4K',
            'Noticias 24 Horas',
            'Cine & Estrenos VOD',
            'Series & Documentales',
            'Canales Infantiles',
            'Eventos Internacionales',
            'Señales Regionales de Chile',
            'Música & Cultura'
          ].map((ch) => (
            <span class="px-3.5 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs font-semibold text-slate-200 backdrop-blur-md hover:border-red-500/40 transition-colors">
              {ch}
            </span>
          ))}
        </div>
      </div>

    </div>

    <!-- Interactive Streaming Showcase Mockup -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="relative rounded-3xl p-4 sm:p-6 bg-gradient-to-b from-white/10 to-white/[0.02] border border-white/10 shadow-2xl backdrop-blur-xl">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="ml-2 font-mono text-slate-300">iptv-chile-stream-player://live</span>
          </div>
          <div class="flex items-center gap-2 font-semibold text-emerald-400">
            <Wifi class="w-4 h-4" />
            <span>Servidor Santiago CDN: Activo (12ms)</span>
          </div>
        </div>

        <!-- Inner Screen View -->
        <div class="rounded-2xl bg-[#060609] p-4 sm:p-6 border border-white/5 relative overflow-hidden space-y-6">
          <div class="rounded-xl overflow-hidden border border-white/10 relative shadow-inner">
            <img 
              src="/images/hero-streaming-chile.webp" 
              alt="Servicio de televisión en vivo IPTV Chile en Smart TV 4K OLED con canales nacionales de Chile y fútbol sin cortes"
              width="1200"
              height="630"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto max-h-[380px] object-cover"
            />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10">
              <div class="flex items-center gap-2 text-red-400 font-bold text-sm mb-1">
                <Tv class="w-4 h-4" />
                <span>Fútbol Chileno en Vivo</span>
              </div>
              <p class="text-xs text-slate-300">
                Colo-Colo, Universidad de Chile, Universidad Católica, Copa Libertadores y Eliminatorias Sudamericanas en 60 FPS sin buffering.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10">
              <div class="flex items-center gap-2 text-blue-400 font-bold text-sm mb-1">
                <Zap class="w-4 h-4" />
                <span>Tecnología Anti-Cortes 9.2</span>
              </div>
              <p class="text-xs text-slate-300">
                Balanceo de carga dinámico con 117+ servidores mundiales y enrutamiento directo para conexiones VTR, Movistar, Claro, Entel y Mundo Pacífico.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10">
              <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm mb-1">
                <ShieldCheck class="w-4 h-4" />
                <span>Activación al Tiro (&lt; 2 min)</span>
              </div>
              <p class="text-xs text-slate-300">
                Instalación guiada paso a paso por WhatsApp. Compatible con IPTV Smarters Pro, TiviMate, Smart IPTV y MAG en cualquier televisor.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
