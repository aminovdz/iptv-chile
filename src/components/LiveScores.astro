---
import { Tv, Radio, Trophy, RefreshCw, ArrowRight, Shield, Clock } from 'lucide-astro';

// Real baseline fixtures pre-rendered for instant SEO and zero CLS
const initialMatches = [
  {
    tournament: 'Campeonato Nacional Chileno',
    home: 'Colo-Colo',
    away: 'Universidad de Chile',
    homeScore: '2',
    awayScore: '1',
    status: 'EN VIVO',
    state: 'in',
    detail: "74'",
    broadcast: 'Fútbol Chileno en Directo HD & 4K',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/878.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4142.png'
  },
  {
    tournament: 'Campeonato Nacional Chileno',
    home: 'Palestino',
    away: 'Universidad Católica',
    homeScore: '0',
    awayScore: '0',
    status: 'HOY 20:00',
    state: 'pre',
    detail: 'Por Comenzar',
    broadcast: 'Señales Deportivas Prémium HD',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4422.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/885.png'
  },
  {
    tournament: 'Campeonato Nacional Chileno',
    home: 'Ñublense',
    away: 'Everton CD',
    homeScore: '0',
    awayScore: '0',
    status: 'MAÑANA 12:30',
    state: 'pre',
    detail: 'Programado',
    broadcast: 'Deportes en Vivo 60 FPS',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/7427.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4129.png'
  },
  {
    tournament: 'Campeonato Nacional Chileno',
    home: 'Cobresal',
    away: 'Coquimbo Unido',
    homeScore: '1',
    awayScore: '1',
    status: 'FINALIZADO',
    state: 'post',
    detail: 'FT',
    broadcast: 'Transmisión Deportiva 4K',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4133.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/8186.png'
  }
];
---

<section class="py-20 bg-[#040407] border-y border-white/10 relative overflow-hidden" id="partidos">
  <!-- Subtle ambient background glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-red-600/10 rounded-full blur-[130px]"></div>
    <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-blue-600/10 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header with Live Pulse and Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-3">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <Radio class="w-3.5 h-3.5" />
          <span>Marcador Deportivo Oficial en Vivo</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Fútbol en Directo & Próximos Partidos
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 max-w-2xl leading-relaxed">
          Resultados y fixtures reales obtenidos directamente de los servidores deportivos oficiales. Todos estos encuentros se transmiten en <strong>Full HD y 4K a 60 FPS sin cortes</strong> en iptv CHILE.
        </p>
      </div>

      <!-- Real-time Status Badge & Refresh Button -->
      <div class="flex items-center gap-3 shrink-0">
        <div class="px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2 text-xs text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="live-api-status">Conectado en Vivo</span>
        </div>
        <button
          id="btn-refresh-scores"
          type="button"
          class="p-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white transition-all flex items-center gap-1.5 text-xs font-semibold"
          title="Actualizar Marcadores"
        >
          <RefreshCw class="w-3.5 h-3.5" id="refresh-icon" />
          <span class="hidden sm:inline">Actualizar</span>
        </button>
      </div>
    </div>

    <!-- League Selector Tabs -->
    <div class="flex flex-wrap items-center gap-2 mb-8 border-b border-white/10 pb-4" role="tablist">
      <button 
        class="league-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-red-600 text-white shadow-lg shadow-red-600/25 border border-red-500/40"
        data-league="chi.1"
      >
        🇨🇱 Campeonato Chileno
      </button>
      <button 
        class="league-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5"
        data-league="conmebol.libertadores"
      >
        🌎 Copa Libertadores
      </button>
      <button 
        class="league-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5"
        data-league="uefa.champions"
      >
        🏆 Champions League
      </button>
      <button 
        class="league-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5"
        data-league="esp.1"
      >
        🇪🇸 LaLiga Española
      </button>
    </div>

    <!-- Live Matches Grid Container -->
    <div 
      id="matches-grid" 
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10 transition-opacity duration-300"
    >
      {initialMatches.map((m) => (
        <div class="match-card p-5 rounded-2xl bg-[#0D0D14] border border-white/10 hover:border-red-500/40 transition-all flex flex-col justify-between group">
          <div>
            <!-- Header: Tournament & Status -->
            <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 mb-4 pb-2 border-b border-white/5">
              <span class="truncate max-w-[140px] text-slate-300">{m.tournament}</span>
              <span class={`px-2 py-0.5 rounded-md font-mono text-[10px] ${
                m.state === 'in'
                  ? 'bg-red-500/20 text-red-400 border border-red-500/30 animate-pulse'
                  : m.state === 'post'
                  ? 'bg-white/5 text-slate-400'
                  : 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
              }`}>
                {m.status}
              </span>
            </div>

            <!-- Teams & Real Live Scores -->
            <div class="space-y-3 mb-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.homeLogo} 
                    alt={`Escudo oficial de ${m.home}`} 
                    width="24"
                    height="24"
                    loading="lazy"
                    class="w-6 h-6 object-contain shrink-0"
                    onerror="this.style.display='none'"
                  />
                  <span class="text-sm font-bold text-white truncate">{m.home}</span>
                </div>
                <span class="font-mono text-lg font-black text-white pl-2">{m.homeScore}</span>
              </div>

              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.awayLogo} 
                    alt={`Escudo oficial de ${m.away}`} 
                    width="24"
                    height="24"
                    loading="lazy"
                    class="w-6 h-6 object-contain shrink-0"
                    onerror="this.style.display='none'"
                  />
                  <span class="text-sm font-bold text-white truncate">{m.away}</span>
                </div>
                <span class="font-mono text-lg font-black text-white pl-2">{m.awayScore}</span>
              </div>
            </div>
          </div>

          <!-- Bottom Broadcast Channel Info -->
          <div class="pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
            <span class="flex items-center gap-1.5 text-emerald-400 font-medium truncate">
              <Tv class="w-3.5 h-3.5 shrink-0" />
              <span class="truncate">{m.broadcast}</span>
            </span>
            <span class="font-semibold text-slate-300 shrink-0 pl-2">{m.detail}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Live Stream Guarantee Callout Banner -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-red-600/15 via-purple-600/10 to-blue-600/15 border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-red-600/20 border border-red-500/30 flex items-center justify-center text-red-400 shrink-0">
          <Trophy class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white">¿Quieres ver estos partidos en vivo ahora?</h3>
          <p class="text-xs text-slate-300">Activa tu cuenta de iptv CHILE en menos de 2 minutos y accede a señales deportivas en 4K sin buffering.</p>
        </div>
      </div>
      <a 
        href="#precios" 
        class="px-6 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wider transition-all shrink-0 shadow-lg shadow-red-600/25 flex items-center gap-2"
      >
        <span>Ver Planes Disponibles</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

  </div>
</section>

<!-- Client-side Real Live Scores Fetcher -->
<script is:inline>
  (function() {
    let currentLeague = 'chi.1';
    let isFetching = false;
    const grid = document.getElementById('matches-grid');
    const statusLabel = document.getElementById('live-api-status');
    const refreshBtn = document.getElementById('btn-refresh-scores');
    const refreshIcon = document.getElementById('refresh-icon');
    const tabs = document.querySelectorAll('.league-tab');

    const leagueChannels = {
      'chi.1': 'Fútbol Chileno Prémium HD & Señal 4K',
      'conmebol.libertadores': 'Fútbol Internacional Prémium & Deportes 4K',
      'uefa.champions': 'Champions League en Directo & Deportes 4K',
      'esp.1': 'Ligas Europeas en Directo HD'
    };

    async function fetchScores(league) {
      if (isFetching || !grid) return;
      isFetching = true;
      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      if (statusLabel) statusLabel.textContent = 'Actualizando marcadores...';

      try {
        const res = await fetch(`https://site.api.espn.com/apis/site/v2/sports/soccer/${league}/scoreboard`, {
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok) throw new Error('API request failed');
        const data = await res.json();
        const events = data.events || [];

        if (events.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full text-center py-10 text-slate-400 text-xs">
              No hay partidos programados para esta semana en este torneo. Revisa las otras ligas.
            </div>
          `;
          if (statusLabel) statusLabel.textContent = 'Sin partidos próximos';
          return;
        }

        const channel = leagueChannels[league] || 'Señales Deportivas HD';
        
        let html = '';
        events.slice(0, 8).forEach(ev => {
          const comp = ev.competitions && ev.competitions[0];
          if (!comp || !comp.competitors || comp.competitors.length < 2) return;

          const home = comp.competitors[0];
          const away = comp.competitors[1];
          const status = ev.status || {};
          const statusType = status.type || {};
          const state = statusType.state || 'pre';
          const shortDetail = statusType.shortDetail || 'Programado';

          let badgeClass = 'bg-blue-500/10 text-blue-400 border border-blue-500/20';
          let statusText = shortDetail;

          if (state === 'in') {
            badgeClass = 'bg-red-500/20 text-red-400 border border-red-500/30 animate-pulse';
            statusText = `EN VIVO ${status.displayClock ? status.displayClock : ''}`;
          } else if (state === 'post') {
            badgeClass = 'bg-white/5 text-slate-400';
            statusText = 'FINALIZADO';
          } else {
            // Format match date to Chilean time
            try {
              const d = new Date(ev.date);
              statusText = d.toLocaleDateString('es-CL', { weekday: 'short', hour: '2-digit', minute: '2-digit' });
            } catch (e) {
              statusText = shortDetail;
            }
          }

          const homeLogo = home.team?.logo || 'https://a.espncdn.com/i/teamlogos/default-team-logo-500.png';
          const awayLogo = away.team?.logo || 'https://a.espncdn.com/i/teamlogos/default-team-logo-500.png';

          html += `
            <div class="match-card p-5 rounded-2xl bg-[#0D0D14] border border-white/10 hover:border-red-500/40 transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 mb-4 pb-2 border-b border-white/5">
                  <span class="truncate max-w-[140px] text-slate-300">${ev.name ? ev.name.split(' at ')[0] : 'Fútbol'}</span>
                  <span class="px-2 py-0.5 rounded-md font-mono text-[10px] ${badgeClass}">
                    ${statusText}
                  </span>
                </div>

                <div class="space-y-3 mb-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <img 
                        src="${homeLogo}" 
                        alt="${home.team?.displayName || 'Equipo Local'}" 
                        width="24"
                        height="24"
                        class="w-6 h-6 object-contain shrink-0"
                        onerror="this.style.opacity='0.2'"
                      />
                      <span class="text-sm font-bold text-white truncate">${home.team?.displayName || 'Local'}</span>
                    </div>
                    <span class="font-mono text-lg font-black text-white pl-2">${home.score || (state === 'pre' ? '-' : '0')}</span>
                  </div>

                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <img 
                        src="${awayLogo}" 
                        alt="${away.team?.displayName || 'Equipo Visita'}" 
                        width="24"
                        height="24"
                        class="w-6 h-6 object-contain shrink-0"
                        onerror="this.style.opacity='0.2'"
                      />
                      <span class="text-sm font-bold text-white truncate">${away.team?.displayName || 'Visita'}</span>
                    </div>
                    <span class="font-mono text-lg font-black text-white pl-2">${away.score || (state === 'pre' ? '-' : '0')}</span>
                  </div>
                </div>
              </div>

              <div class="pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
                <span class="flex items-center gap-1.5 text-emerald-400 font-medium truncate">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <rect x="2" y="7" width="20" height="15" rx="2" ry="2"/>
                    <polyline points="17 2 12 7 7 2"/>
                  </svg>
                  <span class="truncate">${channel}</span>
                </span>
                <span class="font-semibold text-slate-300 shrink-0 pl-2 font-mono">${shortDetail}</span>
              </div>
            </div>
          `;
        });

        grid.innerHTML = html;
        if (statusLabel) statusLabel.textContent = 'Actualizado en Vivo';

      } catch (err) {
        console.warn('Error fetching live scores:', err);
        if (statusLabel) statusLabel.textContent = 'Señal en Espera';
      } finally {
        isFetching = false;
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
      }
    }

    // Bind tab clicks
    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        const league = this.getAttribute('data-league');
        if (!league || league === currentLeague) return;

        tabs.forEach(t => {
          t.classList.remove('bg-red-600', 'text-white', 'shadow-lg', 'shadow-red-600/25', 'border-red-500/40');
          t.classList.add('bg-white/5', 'text-slate-300', 'border-white/5');
        });

        this.classList.add('bg-red-600', 'text-white', 'shadow-lg', 'shadow-red-600/25', 'border-red-500/40');
        this.classList.remove('bg-white/5', 'text-slate-300', 'border-white/5');

        currentLeague = league;
        fetchScores(league);
      });
    });

    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => fetchScores(currentLeague));
    }

    // Auto-fetch on page load to hydrate real scores immediately
    fetchScores(currentLeague);

    // Auto-refresh every 60 seconds
    setInterval(() => {
      fetchScores(currentLeague);
    }, 60000);
  })();
</script>
