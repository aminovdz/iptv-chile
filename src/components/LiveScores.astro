---
import { Tv, Radio, Trophy, RefreshCw, ArrowRight, Clock, ChevronLeft, ChevronRight, Play } from 'lucide-astro';

// Pre-rendered baseline fixtures for instant zero-CLS SSR
const baselineMatches = [
  {
    tournament: 'Campeonato Chileno',
    home: 'Colo-Colo',
    away: 'U. de Chile',
    homeScore: '2',
    awayScore: '1',
    status: 'EN VIVO',
    state: 'in',
    detail: "74'",
    broadcast: 'Señal 4K Directo',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/878.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4142.png'
  },
  {
    tournament: 'Copa Libertadores',
    home: 'Flamengo',
    away: 'Colo-Colo',
    homeScore: '1',
    awayScore: '0',
    status: 'HOY 21:30',
    state: 'pre',
    detail: 'Por Comenzar',
    broadcast: 'Libertadores 4K',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/819.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/878.png'
  },
  {
    tournament: 'Campeonato Chileno',
    home: 'Palestino',
    away: 'U. Católica',
    homeScore: '0',
    awayScore: '0',
    status: 'HOY 20:00',
    state: 'pre',
    detail: 'Por Comenzar',
    broadcast: 'Fútbol HD 60 FPS',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4422.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/885.png'
  },
  {
    tournament: 'Champions League',
    home: 'Real Madrid',
    away: 'Man. City',
    homeScore: '3',
    awayScore: '2',
    status: 'MAÑANA 16:00',
    state: 'pre',
    detail: 'Programado',
    broadcast: 'Champions 4K',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/86.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/382.png'
  },
  {
    tournament: 'Campeonato Chileno',
    home: 'Cobresal',
    away: 'Coquimbo Unido',
    homeScore: '1',
    awayScore: '1',
    status: 'FINALIZADO',
    state: 'post',
    detail: 'FT',
    broadcast: '4K Ultra HD',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4133.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/8186.png'
  },
  {
    tournament: 'LaLiga',
    home: 'Barcelona',
    away: 'Atlético Madrid',
    homeScore: '2',
    awayScore: '1',
    status: 'EN VIVO',
    state: 'in',
    detail: "62'",
    broadcast: 'LaLiga 4K UHD',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/83.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/1068.png'
  }
];

// Duplicate for SSR infinite marquee track
const loopMatches = [...baselineMatches, ...baselineMatches];
---

<section 
  class="relative py-8 bg-[#07070D] border-y border-white/10 overflow-hidden select-none" 
  id="partidos"
  aria-label="Marcador en Vivo de Fútbol"
>
  <!-- Background Glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-80 h-80 bg-red-600/10 rounded-full blur-[120px]"></div>
    <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-80 h-80 bg-blue-600/10 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 mb-4">
    <!-- Header with Live Badge & Quick Link to /livescore/ -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 text-xs font-extrabold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <Radio class="w-3.5 h-3.5" />
          <span>FÚTBOL EN VIVO & FIXTURE</span>
        </div>
        <span class="text-xs text-slate-400 hidden md:inline">
          • Señales en 4K UHD a 60 FPS sin cortes
        </span>
      </div>

      <!-- Action Button to /livescore/ -->
      <a 
        href="/livescore/" 
        class="inline-flex items-center gap-2 text-xs font-bold text-red-400 hover:text-white transition-colors group"
      >
        <span>Abrir Match Center Completo</span>
        <ArrowRight class="w-4 h-4 text-red-400 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>

  <!-- Infinite Loop Carousel Wrapper -->
  <div class="relative w-full overflow-hidden group/carousel">
    <!-- Left & Right Gradient Shadows for seamless edge fade -->
    <div class="absolute top-0 left-0 bottom-0 w-12 sm:w-24 bg-gradient-to-r from-[#07070D] to-transparent z-10 pointer-events-none"></div>
    <div class="absolute top-0 right-0 bottom-0 w-12 sm:w-24 bg-gradient-to-l from-[#07070D] to-transparent z-10 pointer-events-none"></div>

    <!-- Continuous Marquee Track -->
    <div 
      id="livescore-marquee-track" 
      class="marquee-track flex gap-4 py-2 hover:[animation-play-state:paused]"
    >
      {loopMatches.map((m) => (
        <a
          href="/livescore/"
          class="marquee-card shrink-0 w-72 sm:w-80 p-4 rounded-2xl bg-[#0D0D14]/90 border border-white/10 hover:border-red-500/60 hover:bg-[#12121E] transition-all duration-300 hover:scale-[1.02] flex flex-col justify-between shadow-lg hover:shadow-red-600/10 cursor-pointer block text-left"
          title={`Ver partido ${m.home} vs ${m.away} en Match Center`}
        >
          <div>
            <!-- Header: Tournament & Status -->
            <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 mb-2.5 pb-1.5 border-b border-white/5">
              <span class="truncate max-w-[150px] text-slate-300">{m.tournament}</span>
              <span class={`px-2 py-0.5 rounded font-mono text-[10px] font-bold ${
                m.state === 'in'
                  ? 'bg-red-500/20 text-red-400 border border-red-500/40 animate-pulse'
                  : m.state === 'post'
                  ? 'bg-white/5 text-slate-400'
                  : 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
              }`}>
                {m.status}
              </span>
            </div>

            <!-- Teams & Scores -->
            <div class="space-y-2 mb-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.homeLogo} 
                    alt={m.home} 
                    width="22" 
                    height="22" 
                    class="w-5 h-5 object-contain shrink-0" 
                    loading="lazy"
                    onerror="this.style.opacity='0.2'"
                  />
                  <span class="text-xs sm:text-sm font-bold text-white truncate">{m.home}</span>
                </div>
                <span class="font-mono text-base font-black text-white pl-2">{m.homeScore}</span>
              </div>

              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img 
                    src={m.awayLogo} 
                    alt={m.away} 
                    width="22" 
                    height="22" 
                    class="w-5 h-5 object-contain shrink-0" 
                    loading="lazy"
                    onerror="this.style.opacity='0.2'"
                  />
                  <span class="text-xs sm:text-sm font-bold text-white truncate">{m.away}</span>
                </div>
                <span class="font-mono text-base font-black text-white pl-2">{m.awayScore}</span>
              </div>
            </div>
          </div>

          <!-- Bottom: Broadcast & Call-to-action -->
          <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-slate-400">
            <span class="flex items-center gap-1 text-emerald-400 font-semibold truncate">
              <Tv class="w-3 h-3 shrink-0" />
              <span class="truncate">{m.broadcast}</span>
            </span>
            <span class="text-red-400 font-bold group-hover:translate-x-0.5 transition-transform flex items-center gap-0.5">
              <span>Match Center</span>
              <ArrowRight class="w-3 h-3" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Bottom Interactive Tap Banner to /livescore/ -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 text-center">
    <a 
      href="/livescore/" 
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-xs font-semibold transition-all hover:border-red-500/40"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Transmisión en vivo actualizada automáticamente. <strong>Toca cualquier partido para ver marcadores en directo en el Match Center (/livescore)</strong></span>
      <ArrowRight class="w-3.5 h-3.5 text-red-400" />
    </a>
  </div>
</section>

<!-- CSS Infinite Marquee Keyframe Styles -->
<style>
  .marquee-track {
    width: max-content;
    animation: marquee-scroll 38s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Smooth touch/mobile support */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      overflow-x: auto;
    }
  }
</style>

<!-- Client-side real-time match fetcher that clones seamlessly -->
<script is:inline>
  (function() {
    const track = document.getElementById('livescore-marquee-track');
    if (!track) return;

    async function loadLiveCarousel() {
      try {
        // Fetch real Chilean league and international matches
        const [resChi, resLib] = await Promise.all([
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/chi.1/scoreboard', { headers: { 'Accept': 'application/json' } }),
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/conmebol.libertadores/scoreboard', { headers: { 'Accept': 'application/json' } }).catch(() => null)
        ]);

        let events = [];
        if (resChi.ok) {
          const dataChi = await resChi.json();
          events = events.concat(dataChi.events || []);
        }
        if (resLib && resLib.ok) {
          const dataLib = await resLib.json();
          events = events.concat(dataLib.events || []);
        }

        if (events.length === 0) return;

        const cards = events.slice(0, 8).map(ev => {
          const comp = ev.competitions && ev.competitions[0];
          const home = comp?.competitors?.[0] || {};
          const away = comp?.competitors?.[1] || {};
          const status = ev.status || {};
          const statusType = status.type || {};
          const state = statusType.state || 'pre';
          const shortDetail = statusType.shortDetail || 'Programado';

          let badgeClass = 'bg-blue-500/10 text-blue-400 border border-blue-500/20';
          let statusText = shortDetail;

          if (state === 'in') {
            badgeClass = 'bg-red-500/20 text-red-400 border border-red-500/40 animate-pulse';
            statusText = `EN VIVO ${status.displayClock || ''}`;
          } else if (state === 'post') {
            badgeClass = 'bg-white/5 text-slate-400';
            statusText = 'FINALIZADO';
          } else {
            try {
              const d = new Date(ev.date);
              statusText = d.toLocaleDateString('es-CL', { weekday: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'America/Santiago' });
            } catch(e) {
              statusText = shortDetail;
            }
          }

          const homeLogo = home.team?.logo || 'https://a.espncdn.com/i/teamlogos/default-team-logo-500.png';
          const awayLogo = away.team?.logo || 'https://a.espncdn.com/i/teamlogos/default-team-logo-500.png';
          const homeName = home.team?.displayName || 'Local';
          const awayName = away.team?.displayName || 'Visita';
          const tournament = (ev.league && ev.league.name) || ev.name?.split(' at ')[0] || 'Fútbol en Vivo';

          return `
            <a
              href="/livescore/"
              class="marquee-card shrink-0 w-72 sm:w-80 p-4 rounded-2xl bg-[#0D0D14]/90 border border-white/10 hover:border-red-500/60 hover:bg-[#12121E] transition-all duration-300 hover:scale-[1.02] flex flex-col justify-between shadow-lg hover:shadow-red-600/10 cursor-pointer block text-left"
              title="Ver en Match Center /livescore"
            >
              <div>
                <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 mb-2.5 pb-1.5 border-b border-white/5">
                  <span class="truncate max-w-[150px] text-slate-300">${tournament}</span>
                  <span class="px-2 py-0.5 rounded font-mono text-[10px] font-bold ${badgeClass}">
                    ${statusText}
                  </span>
                </div>

                <div class="space-y-2 mb-3">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <img 
                        src="${homeLogo}" 
                        alt="${homeName}" 
                        width="22" 
                        height="22" 
                        class="w-5 h-5 object-contain shrink-0" 
                        onerror="this.style.opacity='0.2'"
                      />
                      <span class="text-xs sm:text-sm font-bold text-white truncate">${homeName}</span>
                    </div>
                    <span class="font-mono text-base font-black text-white pl-2">${home.score || (state === 'pre' ? '-' : '0')}</span>
                  </div>

                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <img 
                        src="${awayLogo}" 
                        alt="${awayName}" 
                        width="22" 
                        height="22" 
                        class="w-5 h-5 object-contain shrink-0" 
                        onerror="this.style.opacity='0.2'"
                      />
                      <span class="text-xs sm:text-sm font-bold text-white truncate">${awayName}</span>
                    </div>
                    <span class="font-mono text-base font-black text-white pl-2">${away.score || (state === 'pre' ? '-' : '0')}</span>
                  </div>
                </div>
              </div>

              <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-slate-400">
                <span class="flex items-center gap-1 text-emerald-400 font-semibold truncate">
                  <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <rect x="2" y="7" width="20" height="15" rx="2" ry="2" stroke-width="2"/>
                    <polyline points="17 2 12 7 7 2" stroke-width="2"/>
                  </svg>
                  <span>4K UHD @ 60 FPS</span>
                </span>
                <span class="text-red-400 font-bold flex items-center gap-0.5">
                  <span>Match Center</span>
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <line x1="5" y1="12" x2="19" y2="12" stroke-width="2"/>
                    <polyline points="12 5 19 12 12 19" stroke-width="2"/>
                  </svg>
                </span>
              </div>
            </a>
          `;
        });

        // Duplicate for seamless infinite marquee loop
        const innerHTML = cards.join('') + cards.join('');
        track.innerHTML = innerHTML;

      } catch (err) {
        console.warn('Live marquee update error:', err);
      }
    }

    loadLiveCarousel();
    // Refresh every 45s
    setInterval(loadLiveCarousel, 45000);
  })();
</script>
