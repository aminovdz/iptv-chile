---
import { Tv, Smartphone, Laptop, Cast, Monitor, ShieldCheck, Download, Sparkles } from 'lucide-astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Dispositivos y Aplicaciones Compatibles con iptv CHILE',
  subtitle = 'Conéctate desde cualquier pantalla. Nuestra señal es universal y compatible con las mejores aplicaciones del mercado.'
} = Astro.props;

const devices = [
  {
    icon: Tv,
    name: 'Smart TV (Samsung & LG)',
    description: 'Compatible con Samsung Tizen, LG webOS, Hisense VIDAA y Philips mediante aplicaciones como IPTV Smarters Pro, Smart IPTV o IBO Player.',
    badge: 'Ideal Living'
  },
  {
    icon: Cast,
    name: 'Amazon Firestick & Fire TV',
    description: 'Rendimiento sobresaliente en Fire TV Stick 4K, Lite y Max. Soporte nativo para TiviMate, Downloader y reproductores Xtream Codes.',
    badge: 'Más Recomendado'
  },
  {
    icon: Tv,
    name: 'Android TV & Google Chromecast',
    description: 'Perfecto para Xiaomi Mi Box, Chromecast con Google TV, Mecool y televisores con sistema Android TV o Google TV integrado.',
    badge: 'Alta Estabilidad'
  },
  {
    icon: Smartphone,
    name: 'iPhone, iPad & Apple TV',
    description: 'Descarga GSE Smart IPTV, IPTV Smarters o XCIPTV desde la App Store oficial de Apple en minutos.',
    badge: 'iOS & tvOS'
  },
  {
    icon: Smartphone,
    name: 'Celulares y Tablets Android',
    description: 'Lleva tus canales y fútbol a todas partes en tu smartphone Android con reproducción fluida en redes móviles 4G y 5G.',
    badge: 'Móvil'
  },
  {
    icon: Laptop,
    name: 'Computadores Windows y Mac',
    description: 'Visualiza canales en tu PC o laptop usando IPTV Smarters para Windows o reproductores multimedia como VLC Player.',
    badge: 'PC & Mac'
  }
];

const recommendedApps = [
  'IPTV Smarters Pro',
  'TiviMate IPTV Player',
  'XCIPTV Player',
  'OTT Navigator',
  'IBO Player',
  'Smart IPTV',
  'SS IPTV',
  'GSE Smart IPTV'
];
---

<section id="dispositivos" class="py-20 bg-[#060609] relative overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Multiplataforma Universal</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Devices Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-14">
      {devices.map((dev) => (
        <div class="p-6 rounded-3xl bg-[#0D0D14] border border-white/10 hover:border-red-500/40 transition-all duration-300 hover:-translate-y-1">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-red-400">
              <dev.icon class="w-6 h-6" />
            </div>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-white/5 text-slate-400 border border-white/5">
              {dev.badge}
            </span>
          </div>

          <h3 class="text-lg font-bold text-white mb-2">
            {dev.name}
          </h3>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            {dev.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Recommended Apps Pill Section -->
    <div class="p-8 rounded-3xl bg-white/[0.02] border border-white/10 text-center max-w-4xl mx-auto">
      <h3 class="text-base font-bold text-white mb-2">
        Aplicaciones Oficiales Recomendadas para Ver IPTV en Chile
      </h3>
      <p class="text-xs text-slate-400 mb-6">
        Todas estas aplicaciones son gratuitas o cuentan con versión de prueba, y se configuran fácilmente con tus credenciales:
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
        {recommendedApps.map((app) => (
          <span class="px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs font-semibold text-slate-200">
            {app}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
