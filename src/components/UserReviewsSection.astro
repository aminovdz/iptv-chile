---
import { Star, CheckCircle, ShieldCheck, ThumbsUp, Sparkles, MapPin } from 'lucide-astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Lo Que Opinan Nuestros Clientes en Chile',
  subtitle = 'Más de 2.100 suscriptores satisfechos disfrutan de señal en 4K, cero cortes en el fútbol chileno y atención inmediata.'
} = Astro.props;

const reviews = [
  {
    name: 'Gonzalo Morales',
    city: 'Santiago, Región Metropolitana',
    rating: 5,
    plan: 'Plan Anual 12 Meses',
    comment: 'Llevaba 3 años pagando $62.000 mensuales en VTR y los partidos de Colo-Colo se cortaban en horas punta. Me cambié a iptv CHILE con fibra y la transmisión deportiva va fluida a 60 FPS sin buffering. Además me regalaron la app premium para mi Smart TV. Tremendo servicio po!',
    date: 'Hace 3 días'
  },
  {
    name: 'Carolina Fuentes',
    city: 'Viña del Mar',
    rating: 5,
    plan: 'Plan Anual 12 Meses',
    comment: 'Instalado en un Smart TV LG en el living y en un Firestick en el dormitorio. La guía EPG funciona perfecto y la calidad en películas y series es realmente 4K. La atención por WhatsApp fue al tiro en menos de 5 minutos.',
    date: 'Hace 5 días'
  },
  {
    name: 'Matías Riquelme',
    city: 'Concepción, Biobío',
    rating: 5,
    plan: 'Plan 6 Meses',
    comment: 'Excelente estabilidad con internet de Mundo Pacífico. Veo toda la Copa Libertadores, la Champions y la Liga Chilena sin ningún freeze. Pagué por WebPay con débito rápido y seguro.',
    date: 'Hace 1 semana'
  },
  {
    name: 'Felipe Valenzuela',
    city: 'Antofagasta',
    rating: 5,
    plan: 'Plan Anual 12 Meses',
    comment: 'Al principio tenía dudas por malas experiencias con otros proveedores baratos. Pero con iptv CHILE la calidad es otro nivel. Soporte técnico de verdad, responden a cualquier hora y te ayudan a configurar.',
    date: 'Hace 1 semana'
  },
  {
    name: 'Ignacio Silva',
    city: 'Temuco',
    rating: 5,
    plan: 'Plan 3 Meses',
    comment: 'Muy buena experiencia. Me sorprendió la nitidez de los canales nacionales en HD y las señales deportivas. Recomiendo 100% para quienes quieran ahorrar y tener mejor servicio que el cable.',
    date: 'Hace 2 semanas'
  },
  {
    name: 'Daniela Soto',
    city: 'La Serena',
    rating: 5,
    plan: 'Plan Anual 12 Meses',
    comment: 'Aproveché la promo con la aplicación premium gratis incluida por contratar el plan de 12 meses. Funciona impecable en mi tablet Samsung y televisor. Ya recomendé a dos familiares con el link de referidos y me dieron meses extra.',
    date: 'Hace 3 semanas'
  }
];
---

<section id="testimonios" class="py-20 bg-[#060609] relative overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Opiniones 100% Reales Verificadas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {subtitle}
      </p>

      <!-- Aggregate Score Callout -->
      <div class="mt-6 inline-flex items-center gap-4 px-6 py-3 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md">
        <div class="flex items-center gap-1 text-amber-400">
          {[...Array(5)].map(() => (
            <Star class="w-4 h-4 fill-current" />
          ))}
        </div>
        <div class="text-xs font-semibold text-slate-200">
          <strong class="text-white text-sm">4.9 / 5.0</strong> basado en más de 2.180 clientes chilenos activos
        </div>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="p-6 sm:p-7 rounded-3xl bg-[#0D0D14] border border-white/10 hover:border-red-500/30 transition-all duration-300 flex flex-col justify-between">
          <div>
            <!-- Stars & Verified Badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1 text-amber-400">
                {[...Array(rev.rating)].map(() => (
                  <Star class="w-3.5 h-3.5 fill-current" />
                ))}
              </div>
              <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
                <CheckCircle class="w-3 h-3" />
                <span>Cliente Verificado</span>
              </span>
            </div>

            <!-- Review Text -->
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 italic">
              "{rev.comment}"
            </p>
          </div>

          <!-- Reviewer Footer -->
          <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs">
            <div>
              <div class="font-bold text-white text-sm">{rev.name}</div>
              <div class="text-[11px] text-slate-400 flex items-center gap-1 mt-0.5">
                <MapPin class="w-3 h-3 text-red-400" />
                <span>{rev.city}</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-[10px] font-bold text-red-400 block">{rev.plan}</span>
              <span class="text-[10px] text-slate-500">{rev.date}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
