---
import { Menu, X, Play, Globe, MessageSquare, ShieldCheck, Sparkles, ChevronDown, Flame } from 'lucide-astro';

interface Props {
  lang?: string;
}

const { lang = 'es-CL' } = Astro.props;

const navLinks = [
  { name: 'Características', href: '/#caracteristicas' },
  { name: 'Planes & Precios', href: '/#precios' },
  { name: 'Partidos en Vivo', href: '/#partidos' },
  { name: 'Dispositivos', href: '/#dispositivos' },
  { name: 'Ciudades', href: '#ciudades' },
  { name: 'Ultra IPTV', href: '/ultra-iptv' },
  { name: 'Comparador', href: '/compare/iptv-chile-vs-competitors' },
  { name: 'Guías', href: '/guides' },
  { name: 'Contacto', href: '/contact' }
];

const cityLinks = [
  { name: 'Santiago (RM)', href: '/locations/santiago' },
  { name: 'Valparaíso', href: '/locations/valparaiso' },
  { name: 'Concepción', href: '/locations/concepcion' },
  { name: 'Viña del Mar', href: '/locations/vina-del-mar' },
  { name: 'Antofagasta', href: '/locations/antofagasta' },
  { name: 'Temuco', href: '/locations/temuco' },
  { name: 'La Serena', href: '/locations/la-serena' },
  { name: 'Puerto Montt', href: '/locations/puerto-montt' }
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#060609]/90 border-b border-white/10 transition-all duration-300" id="main-header">
  <!-- Top Micro Notice Bar for Trust -->
  <div class="bg-gradient-to-r from-red-600 via-red-700 to-blue-900 text-white text-xs font-medium py-1.5 px-4 text-center border-b border-red-500/20">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <span class="flex items-center gap-1.5 mx-auto md:mx-0">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>🇨🇱 <strong>Servidores de Ultra-Baja Latencia en Chile:</strong> Transmisión 4K en Liga Chilena, Fútbol en Vivo y TV Nacional | 🎁 App Premium Gratis en Plan 12 Meses</span>
      </span>
      <div class="hidden md:flex items-center gap-4 text-[11px] text-slate-200">
        <span class="flex items-center gap-1"><ShieldCheck class="w-3.5 h-3.5 text-emerald-400" /> Sin Contratos Ni Cortes de Cable</span>
        <span>|</span>
        <a href="https://wa.me/18036582620?text=Hola!%20Quiero%20información%20de%20iptv%20CHILE" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
          <MessageSquare class="w-3 h-3 text-emerald-400" /> WhatsApp Directo: +1 (803) 658-2620
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="iptv CHILE Inicio">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-red-600 to-blue-800 flex items-center justify-center text-white shadow-lg shadow-red-600/25 group-hover:scale-105 transition-transform duration-200 border border-white/20">
          <svg class="w-6 h-6 fill-white" viewBox="0 0 24 24">
            <polygon points="5,3 19,12 5,21"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-2xl tracking-tight text-white flex items-center">
            iptv<span class="text-red-500 ml-1">CHILE</span>
          </span>
          <span class="text-[10px] text-slate-400 tracking-wider uppercase font-semibold">Streaming Premium 4K</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2" aria-label="Navegación Principal">
        {navLinks.map((link) => (
          link.name === 'Ciudades' ? (
            <div class="relative group">
              <button 
                type="button"
                class="text-slate-300 hover:text-white px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1 group-hover:bg-white/5"
                aria-expanded="false"
              >
                <span>{link.name}</span>
                <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover:text-white transition-transform group-hover:rotate-180" />
              </button>
              <div class="absolute left-0 mt-1 w-52 rounded-xl bg-[#0D0D14] border border-white/10 shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 backdrop-blur-xl">
                {cityLinks.map((city) => (
                  <a 
                    href={city.href} 
                    class="block px-4 py-2 text-xs font-medium text-slate-300 hover:text-white hover:bg-red-600/20 transition-colors"
                  >
                    IPTV {city.name}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a 
              href={link.href} 
              class="text-slate-300 hover:text-white px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-white/5"
            >
              {link.name}
            </a>
          )
        ))}
      </nav>

      <!-- Action Button Group -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="/#precios" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-xs tracking-wide shadow-lg shadow-red-600/30 transition-all duration-200 hover:scale-[1.02]"
        >
          <Sparkles class="w-3.5 h-3.5" />
          <span>Ver Planes</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 focus:outline-none"
          aria-label="Abrir Menú Móvil"
          aria-expanded="false"
        >
          <Menu class="w-6 h-6 block" id="menu-icon" />
          <X class="w-6 h-6 hidden" id="close-icon" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-menu" 
    class="lg:hidden hidden border-t border-white/10 bg-[#060609]/95 backdrop-blur-2xl px-4 pt-4 pb-8 space-y-4 max-h-[85vh] overflow-y-auto"
  >
    <div class="grid grid-cols-1 gap-1">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:text-white hover:bg-white/5 transition-colors"
        >
          {link.name}
        </a>
      ))}
    </div>

    <!-- Mobile Cities Expandable Group -->
    <div class="pt-2 border-t border-white/10">
      <div class="text-xs uppercase tracking-wider text-slate-400 font-bold px-3 mb-2">Cobertura en Chile:</div>
      <div class="grid grid-cols-2 gap-1 px-1">
        {cityLinks.map((city) => (
          <a 
            href={city.href} 
            class="px-3 py-1.5 rounded-md text-xs font-medium text-slate-300 hover:text-white hover:bg-red-600/20"
          >
            {city.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile CTA Buttons -->
    <div class="pt-4 border-t border-white/10 space-y-2">
      <a 
        href="/#precios" 
        class="w-full py-3 rounded-xl bg-gradient-to-r from-red-600 to-red-700 text-white font-bold text-center block text-sm shadow-lg shadow-red-600/30"
      >
        <span>Ver Planes y Precios (desde $5 USD)</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });

    // Close menu when clicking link
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
