---
import { CreditCard, Send, Tv, ArrowRight, Sparkles, CheckCircle2 } from 'lucide-astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = '¿Cómo Empezar a Usar iptv CHILE? — Activación en 3 Pasos',
  subtitle = 'Sin visitas de técnicos, sin cables enredados y sin contratos forzosos. Empieza a disfrutar de tus canales favoritos hoy mismo.'
} = Astro.props;

const steps = [
  {
    step: '01',
    icon: CreditCard,
    title: 'Elige Tu Plan',
    description: 'Selecciona la duración de suscripción que mejor se adapte a tu hogar (12, 6, 3 o 1 mes). Aceptamos WebPay, Mercado Pago, transferencias y tarjetas.',
    tip: 'El plan de 12 meses incluye 1 mes gratis adicional'
  },
  {
    step: '02',
    icon: Send,
    title: 'Recibe Tus Credenciales',
    description: 'Tras confirmar tu pago, nuestro equipo de soporte te enviará tus accesos (usuario, contraseña y URL Xtream/M3U) al tiro directamente por WhatsApp.',
    tip: 'Activación garantizada en menos de 2 minutos'
  },
  {
    step: '03',
    icon: Tv,
    title: 'Conéctate y Disfruta en 4K',
    description: 'Ingresa los datos en tu aplicación preferida (IPTV Smarters Pro, TiviMate, Smart IPTV u otra) y disfruta al instante de todos los canales y partidos en vivo.',
    tip: 'Te guiamos paso a paso durante la configuración'
  }
];
---

<section id="proceso" class="py-20 bg-[#0A0A10] relative overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>Instalación Simple & Sin Complicaciones</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((item, idx) => (
        <div class="relative rounded-3xl p-8 bg-[#0D0D14] border border-white/10 flex flex-col justify-between hover:border-red-500/40 transition-all duration-300 group hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-4xl font-black text-white/20 group-hover:text-red-500/40 transition-colors font-mono">
                {item.step}
              </span>
              <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-red-400 group-hover:scale-110 group-hover:border-red-500 transition-all">
                <item.icon class="w-6 h-6" />
              </div>
            </div>

            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">
              {item.title}
            </h3>

            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex items-center gap-2 text-xs font-semibold text-emerald-400">
            <CheckCircle2 class="w-4 h-4 shrink-0" />
            <span>{item.tip}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Bar -->
    <div class="mt-12 text-center">
      <a 
        href="https://wa.me/18036582620?text=Hola!%20Deseo%20ayuda%20para%20instalar%20iptv%20CHILE%20en%20mi%20dispositivo" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-bold text-slate-300 hover:text-white transition-colors"
      >
        <span>¿Tienes dudas sobre la instalación en tu modelo de televisor? Habla con un técnico</span>
        <ArrowRight class="w-4 h-4 text-red-400" />
      </a>
    </div>

  </div>
</section>
