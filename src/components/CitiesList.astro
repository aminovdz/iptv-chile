---
import { MapPin, ArrowRight, Wifi, ShieldCheck, Sparkles } from 'lucide-astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Servicio Local de iptv CHILE en las Principales Ciudades',
  subtitle = 'Disponemos de servidores CDN con enrutamiento prioritario para operadores locales (VTR, Movistar, Entel, Claro y Mundo Pacífico) en cada región de Chile.'
} = Astro.props;

const cities = [
  {
    name: 'Santiago',
    region: 'Región Metropolitana',
    slug: 'santiago',
    description: 'Nodo central de máxima velocidad para el Gran Santiago, Maipú, Puente Alto, Las Condes y La Florida.',
    latency: '8-14 ms'
  },
  {
    name: 'Valparaíso',
    region: 'Región de Valparaíso',
    slug: 'valparaiso',
    description: 'Servidores costeros dedicados con conexión ultraestable para el puerto y comunas aledañas.',
    latency: '12-18 ms'
  },
  {
    name: 'Concepción',
    region: 'Región del Biobío',
    slug: 'concepcion',
    description: 'Nodo de alta capacidad para Concepción, Talcahuano, San Pedro de la Paz y Coronel.',
    latency: '15-20 ms'
  },
  {
    name: 'Viña del Mar',
    region: 'Región de Valparaíso',
    slug: 'vina-del-mar',
    description: 'Señal en 4K optimizada para conexiones de fibra óptica en Reñaca, Concón y el centro de Viña.',
    latency: '12-18 ms'
  },
  {
    name: 'Antofagasta',
    region: 'Región de Antofagasta',
    slug: 'antofagasta',
    description: 'Nodo del Norte Grande para minería y hogares con transmisión ininterrumpida de fútbol en directo.',
    latency: '18-24 ms'
  },
  {
    name: 'Temuco',
    region: 'Región de La Araucanía',
    slug: 'temuco',
    description: 'Distribución CDN para Temuco, Padre Las Casas y la zona centro-sur con calidad FHD y 4K.',
    latency: '18-25 ms'
  },
  {
    name: 'La Serena',
    region: 'Región de Coquimbo',
    slug: 'la-serena',
    description: 'Nodo Norte Chico para La Serena y Coquimbo con excelente estabilidad en transmisiones deportivas.',
    latency: '14-20 ms'
  },
  {
    name: 'Puerto Montt',
    region: 'Región de Los Lagos',
    slug: 'puerto-montt',
    description: 'Conectividad para la zona sur austral de Chile con balanceo de carga para redes residenciales.',
    latency: '22-28 ms'
  }
];
---

<section id="ciudades-grid" class="py-20 bg-[#0A0A10] relative overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
        <MapPin class="w-3.5 h-3.5" />
        <span>Presencia Geográfica en Todo Chile</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        {title}
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Cities Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {cities.map((city) => (
        <a 
          href={`/locations/${city.slug}/`}
          class="group p-6 rounded-3xl bg-[#0D0D14] border border-white/10 hover:border-red-500/40 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-red-400 uppercase tracking-wider">
                {city.region}
              </span>
              <span class="inline-flex items-center gap-1 text-[11px] font-mono text-emerald-400">
                <Wifi class="w-3 h-3" />
                <span>{city.latency}</span>
              </span>
            </div>

            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-red-400 transition-colors">
              IPTV {city.name}
            </h3>

            <p class="text-xs text-slate-400 leading-relaxed mb-6">
              {city.description}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-slate-300 group-hover:text-white">
            <span>Ver Servidor Local</span>
            <ArrowRight class="w-4 h-4 text-red-400 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
