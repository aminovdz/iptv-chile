---
import { Sparkles, MessageSquare, ArrowRight, ShieldCheck, Zap, Clock } from 'lucide-astro';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
  secondaryText?: string;
  secondaryLink?: string;
}

const {
  buttonLink = '#precios',
  secondaryLink = 'https://wa.me/18036582620?text=Hola!%20Quiero%20activar%20mi%20cuenta%20de%20iptv%20CHILE',
  title = '¿Listo para Disfrutar la Mejor Televisión en Vivo sin Pagar de Más en Chile?',
  description = 'Súmate a miles de familias chilenas que ya cortaron el cable tradicional. Disfruta de fútbol en vivo, canales nacionales, cine y series en calidad 4K con activación al tiro en menos de 2 minutos.',
  buttonText = 'Elige Tu Plan IPTV (desde $5 USD)',
  secondaryText = 'Hablar por WhatsApp con Soporte'
} = Astro.props;
---

<section class="py-16 sm:py-24 relative overflow-hidden bg-[#060609]">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-red-600/15 rounded-full blur-[140px]"></div>
    <div class="absolute bottom-0 right-10 w-80 h-80 bg-blue-600/10 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="relative rounded-3xl p-8 sm:p-12 lg:p-16 bg-gradient-to-br from-white/[0.08] via-white/[0.03] to-red-950/25 border border-white/10 shadow-2xl backdrop-blur-2xl text-center overflow-hidden">
      
      <!-- Ambient Glow Border -->
      <div class="absolute -top-24 -left-24 w-48 h-48 bg-red-600/30 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-blue-600/25 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-6">
        <Clock class="w-3.5 h-3.5" />
        <span>Activación al Tiro en Menos de 2 Minutos</span>
      </div>

      <!-- Main Headline -->
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6 max-w-3xl mx-auto">
        {title}
      </h2>

      <!-- Description -->
      <p class="text-base sm:text-lg text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
        {description}
      </p>

      <!-- Trust Pills -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-300 font-medium mb-10">
        <span class="flex items-center gap-1.5">
          <ShieldCheck class="w-4 h-4 text-emerald-400" />
          <span>Garantía de Devolución de 24 Horas</span>
        </span>
        <span class="flex items-center gap-1.5">
          <Zap class="w-4 h-4 text-emerald-400" />
          <span>Servidores CDN Anti-Cortes</span>
        </span>
        <span class="flex items-center gap-1.5">
          <Sparkles class="w-4 h-4 text-emerald-400" />
          <span>Sin Facturas Sorpresa Ni Contratos</span>
        </span>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={buttonLink} 
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-red-600 via-red-700 to-red-600 hover:from-red-500 hover:to-red-600 text-white font-extrabold text-base shadow-xl shadow-red-600/30 transition-all duration-300 hover:scale-105 flex items-center justify-center gap-3 border border-red-400/40"
        >
          <span>{buttonText}</span>
          <ArrowRight class="w-5 h-5" />
        </a>

        <a 
          href={secondaryLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-white/5 hover:bg-white/10 text-white font-bold text-base border border-white/10 hover:border-emerald-500/40 transition-all duration-200 flex items-center justify-center gap-3 backdrop-blur-xl hover:text-emerald-300"
        >
          <MessageSquare class="w-5 h-5 text-emerald-400" />
          <span>{secondaryText}</span>
        </a>
      </div>

    </div>
  </div>
</section>
