---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import PricingCard from '../components/PricingCard.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import ExitPopup from '../components/ExitPopup.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SocialPopup from '../components/SocialPopup.astro';
import { 
  Radio, 
  Trophy, 
  Tv, 
  RefreshCw, 
  Clock, 
  Calendar, 
  ArrowRight, 
  ShieldCheck, 
  Flame, 
  Zap, 
  CheckCircle2, 
  Play, 
  Globe 
} from 'lucide-astro';

const currentYear = new Date().getFullYear();
const pageTitle = `Marcador de Fútbol en Vivo & Partidos Hoy ${currentYear} | Match Center — iptv CHILE`;
const pageDescription = `Sigue en tiempo real los marcadores, fixture y resultados del Campeonato Nacional Chileno, Copa Libertadores, Champions League y ligas internacionales. Disfruta de la transmisión en 4K a 60 FPS sin cortes en iptv CHILE.`;

// Pre-rendered baseline fixtures for instant zero-CLS SSR
const defaultMatches = [
  {
    tournament: 'Campeonato Nacional Chileno',
    round: 'Fecha Regular',
    home: 'Colo-Colo',
    away: 'Universidad de Chile',
    homeScore: '2',
    awayScore: '1',
    status: 'EN VIVO',
    state: 'in',
    detail: "74'",
    broadcast: 'Fútbol Chileno en Directo HD & 4K',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/878.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4142.png',
    stadium: 'Estadio Monumental, Santiago'
  },
  {
    tournament: 'Campeonato Nacional Chileno',
    round: 'Fecha Regular',
    home: 'Palestino',
    away: 'Universidad Católica',
    homeScore: '0',
    awayScore: '0',
    status: 'HOY 20:00',
    state: 'pre',
    detail: 'Por Comenzar',
    broadcast: 'Señales Deportivas Prémium HD',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4422.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/885.png',
    stadium: 'Estadio Municipal de La Cisterna'
  },
  {
    tournament: 'Campeonato Nacional Chileno',
    round: 'Fecha Regular',
    home: 'Ñublense',
    away: 'Everton CD',
    homeScore: '0',
    awayScore: '0',
    status: 'MAÑANA 12:30',
    state: 'pre',
    detail: 'Programado',
    broadcast: 'Deportes en Vivo 60 FPS',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/7427.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4129.png',
    stadium: 'Estadio Nelson Oyarzún, Chillán'
  },
  {
    tournament: 'Campeonato Nacional Chileno',
    round: 'Fecha Regular',
    home: 'Cobresal',
    away: 'Coquimbo Unido',
    homeScore: '1',
    awayScore: '1',
    status: 'FINALIZADO',
    state: 'post',
    detail: 'FT',
    broadcast: 'Transmisión Deportiva 4K',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/4133.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/8186.png',
    stadium: 'Estadio El Cobre, El Salvador'
  },
  {
    tournament: 'Copa Conmebol Libertadores',
    round: 'Fase de Grupos',
    home: 'Flamengo',
    away: 'Colo-Colo',
    homeScore: '1',
    awayScore: '0',
    status: 'HOY 21:30',
    state: 'pre',
    detail: 'Por Comenzar',
    broadcast: 'Copa Libertadores en 4K Nativo',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/819.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/878.png',
    stadium: 'Estadio Maracaná, Río de Janeiro'
  },
  {
    tournament: 'UEFA Champions League',
    round: 'Octavos de Final',
    home: 'Real Madrid',
    away: 'Manchester City',
    homeScore: '3',
    awayScore: '2',
    status: 'MAÑANA 16:00',
    state: 'pre',
    detail: 'Programado',
    broadcast: 'Señales Europeas 4K UHD',
    homeLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/86.png',
    awayLogo: 'https://a.espncdn.com/i/teamlogos/soccer/500/382.png',
    stadium: 'Santiago Bernabéu, Madrid'
  }
];

const matchCenterSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://chileiptv.live/livescore/#webpage",
  "url": "https://chileiptv.live/livescore/",
  "name": pageTitle,
  "description": pageDescription,
  "inLanguage": "es-CL",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://chileiptv.live/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Match Center Live Score",
        "item": "https://chileiptv.live/livescore/"
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="/livescore/"
  pageSchema={matchCenterSchema}
>
  <StickyHeader />

  <main class="min-h-screen bg-[#060609] text-slate-100">
    <!-- Hero / Match Center Header -->
    <section class="relative pt-12 pb-10 overflow-hidden border-b border-white/10 bg-gradient-to-b from-[#0e0f1a] to-[#060609]">
      <!-- Background Ambient Glow -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -top-24 left-1/3 w-[500px] h-[500px] bg-red-600/15 rounded-full blur-[140px]"></div>
        <div class="absolute top-1/2 right-1/4 w-[400px] h-[400px] bg-blue-600/10 rounded-full blur-[130px]"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-red-400 transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-white font-medium">Match Center en Vivo</span>
        </nav>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-3">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
              <Radio class="w-3.5 h-3.5" />
              <span>CENTRO OFICIAL DE PARTIDOS EN VIVO 24/7</span>
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
              Match Center: Marcadores de Fútbol en Directo & Resultados Hoy
            </h1>
            <p class="text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
              Sigue cada gol, minuto y resultado en directo de las principales ligas del mundo. Todos estos encuentros los transmitimos en <strong>4K real a 60 FPS sin buffering</strong> a través de nuestra red de servidores en Chile.
            </p>
          </div>

          <!-- Real-Time Auto-Refresh Box -->
          <div class="p-5 rounded-2xl bg-[#0D0D14] border border-white/10 shrink-0 w-full lg:w-80 shadow-2xl">
            <div class="flex items-center justify-between mb-3 text-xs">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="font-bold text-white" id="live-api-status">Conectado en Vivo</span>
              </div>
              <button
                id="btn-refresh-scores"
                type="button"
                class="p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white transition-all flex items-center gap-1 text-[11px] font-semibold"
                title="Actualizar Marcadores"
              >
                <RefreshCw class="w-3.5 h-3.5" id="refresh-icon" />
                <span>Refrescar</span>
              </button>
            </div>

            <!-- Auto-refresh Countdown -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-[11px] text-slate-400">
                <span class="flex items-center gap-1">
                  <Clock class="w-3 h-3 text-red-400" />
                  <span>Próxima actualización en:</span>
                </span>
                <span class="font-mono text-white font-bold" id="countdown-timer">30s</span>
              </div>
              <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                <div id="countdown-bar" class="bg-gradient-to-r from-red-500 to-emerald-400 h-full w-full transition-all duration-1000 ease-linear"></div>
              </div>
            </div>

            <div class="mt-3 pt-3 border-t border-white/5 flex items-center justify-between text-[11px]">
              <span class="text-slate-400">Hora Oficial Chile:</span>
              <span class="font-mono text-emerald-400 font-bold" id="chile-clock">--:--:--</span>
            </div>
          </div>
        </div>

        <!-- League Tabs Switcher -->
        <div class="mt-8 flex flex-wrap items-center gap-2 border-b border-white/10 pb-4 overflow-x-auto" role="tablist">
          <button 
            class="league-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all bg-red-600 text-white shadow-lg shadow-red-600/25 border border-red-500/40 shrink-0"
            data-league="chi.1"
          >
            🇨🇱 Campeonato Chileno
          </button>
          <button 
            class="league-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5 shrink-0"
            data-league="conmebol.libertadores"
          >
            🌎 Copa Libertadores
          </button>
          <button 
            class="league-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5 shrink-0"
            data-league="uefa.champions"
          >
            🏆 Champions League
          </button>
          <button 
            class="league-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5 shrink-0"
            data-league="esp.1"
          >
            🇪🇸 LaLiga
          </button>
          <button 
            class="league-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5 shrink-0"
            data-league="eng.1"
          >
            🏴󠁧󠁢󠁥󠁮󠁧󠁿 Premier League
          </button>
          <button 
            class="league-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5 shrink-0"
            data-league="arg.1"
          >
            🇦🇷 Liga Argentina
          </button>
          <button 
            class="league-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/5 shrink-0"
            data-league="conmebol.sudamericana"
          >
            🏆 Copa Sudamericana
          </button>
        </div>
      </div>
    </section>

    <!-- Main Matches Grid Section -->
    <section class="py-12 bg-[#060609]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Filter Pills Bar -->
        <div class="flex items-center justify-between mb-8 gap-4 flex-wrap">
          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Filtro:</span>
            <button class="filter-pill px-3 py-1.5 rounded-lg text-xs font-bold bg-white/10 text-white border border-white/20 active" data-filter="all">Todos</button>
            <button class="filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/5 text-slate-400 hover:text-white border border-white/5" data-filter="live">🔴 En Vivo</button>
            <button class="filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/5 text-slate-400 hover:text-white border border-white/5" data-filter="today">⏱️ Hoy</button>
            <button class="filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-white/5 text-slate-400 hover:text-white border border-white/5" data-filter="upcoming">📅 Próximos</button>
          </div>

          <div class="text-xs text-slate-400">
            Mostrando partidos de <span id="current-league-label" class="text-red-400 font-bold">Campeonato Chileno</span>
          </div>
        </div>

        <!-- Matches Cards Grid Container -->
        <div 
          id="matches-grid" 
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12 transition-opacity duration-300"
        >
          {defaultMatches.map((m) => (
            <div class="match-card p-6 rounded-3xl bg-[#0D0D14] border border-white/10 hover:border-red-500/50 transition-all duration-300 flex flex-col justify-between group shadow-xl hover:-translate-y-1">
              <div>
                <!-- Card Header -->
                <div class="flex items-center justify-between text-xs font-bold text-slate-400 mb-4 pb-3 border-b border-white/5">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <Trophy class="w-3.5 h-3.5 text-amber-400 shrink-0" />
                    <span class="truncate text-slate-300">{m.tournament}</span>
                  </div>
                  <span class={`px-2.5 py-1 rounded-md font-mono text-[11px] font-bold ${
                    m.state === 'in'
                      ? 'bg-red-500/20 text-red-400 border border-red-500/40 animate-pulse'
                      : m.state === 'post'
                      ? 'bg-white/5 text-slate-400'
                      : 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
                  }`}>
                    {m.status}
                  </span>
                </div>

                <!-- Teams & Live Scores -->
                <div class="space-y-4 mb-5">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3 min-w-0">
                      <img 
                        src={m.homeLogo} 
                        alt={`Escudo de ${m.home}`} 
                        width="32" 
                        height="32" 
                        class="w-8 h-8 object-contain shrink-0" 
                        onerror="this.style.opacity='0.2'"
                      />
                      <span class="text-base font-bold text-white truncate">{m.home}</span>
                    </div>
                    <span class="font-mono text-2xl font-black text-white pl-3">{m.homeScore}</span>
                  </div>

                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3 min-w-0">
                      <img 
                        src={m.awayLogo} 
                        alt={`Escudo de ${m.away}`} 
                        width="32" 
                        height="32" 
                        class="w-8 h-8 object-contain shrink-0" 
                        onerror="this.style.opacity='0.2'"
                      />
                      <span class="text-base font-bold text-white truncate">{m.away}</span>
                    </div>
                    <span class="font-mono text-2xl font-black text-white pl-3">{m.awayScore}</span>
                  </div>
                </div>

                {m.stadium && (
                  <p class="text-[11px] text-slate-400 mb-4 flex items-center gap-1.5">
                    <Globe class="w-3 h-3 text-slate-400" />
                    <span>{m.stadium}</span>
                  </p>
                )}
              </div>

              <div>
                <!-- Broadcast Channel Badge -->
                <div class="p-3 rounded-xl bg-white/5 border border-white/5 mb-4 flex items-center justify-between text-xs">
                  <span class="flex items-center gap-1.5 text-emerald-400 font-semibold truncate">
                    <Tv class="w-3.5 h-3.5 shrink-0" />
                    <span class="truncate">{m.broadcast}</span>
                  </span>
                  <span class="font-mono font-bold text-slate-300 shrink-0 pl-2">{m.detail}</span>
                </div>

                <!-- Direct Action Link to Watch in 4K -->
                <a
                  href={`https://wa.me/213550592200?text=${encodeURIComponent(`Hola! Deseo activar iptv CHILE para ver el partido de ${m.home} vs ${m.away} en vivo en 4K.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-red-600/20 group-hover:scale-[1.02]"
                >
                  <Play class="w-3.5 h-3.5 fill-current" />
                  <span>Sintonizar en 4K sin Cortes</span>
                  <ArrowRight class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- High-Impact Live Stream Guarantee Banner -->
        <div class="p-8 rounded-3xl bg-gradient-to-r from-red-600/20 via-purple-600/15 to-blue-900/30 border border-white/10 relative overflow-hidden mb-16">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6 relative z-10">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-2xl bg-red-600/20 border border-red-500/40 text-red-400 flex items-center justify-center shrink-0">
                <Trophy class="w-7 h-7" />
              </div>
              <div>
                <span class="text-xs font-bold text-red-400 uppercase tracking-wider">Transmisión Garantizada a 60 FPS</span>
                <h3 class="text-xl sm:text-2xl font-black text-white mt-1">
                  ¿Cansado de que el partido se congele en el minuto 85?
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 mt-2 max-w-2xl leading-relaxed">
                  Con <strong>iptv CHILE</strong> tienes servidores locales CDN en Santiago y regiones conectados a los principales proveedores (VTR, Movistar, Entel, Claro y Mundo). Mira todos los partidos en 4K UHD sin lag ni saturación.
                </p>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
              <a 
                href="#precios"
                class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs uppercase tracking-wider transition-all shadow-xl shadow-red-600/25 text-center flex items-center justify-center gap-2"
              >
                <span>Ver Planes desde $5 USD</span>
                <ArrowRight class="w-4 h-4" />
              </a>
              <a 
                href="https://wa.me/213550592200?text=Hola!%20Quiero%20solicitar%20mi%20prueba%20gratuita%20de%2024%20horas%20para%20probar%20los%20canales%20de%20deportes."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs uppercase tracking-wider transition-all border border-white/10 text-center"
              >
                Prueba Gratis 24 Horas
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Pricing Section Anchor -->
    <PricingCard />

    <!-- Technical Trust Features -->
    <section class="py-16 bg-[#040407] border-t border-white/5 text-slate-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs uppercase font-bold text-red-400 tracking-wider">Infraestructura Especializada</span>
          <h2 class="text-3xl font-extrabold text-white mt-2 mb-3">
            Por Qué iptv CHILE es la Mejor Opción para Fanáticos del Fútbol
          </h2>
          <p class="text-xs sm:text-sm text-slate-400">
            Diseñado especialmente para alta concurrencia en clásicos y finales de campeonatos.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-[#0D0D14] border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-4">
              <Zap class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-bold text-white mb-2">60 Cuadros por Segundo (60 FPS)</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              A diferencia de servicios piratas que transmiten a 25 o 30 FPS generando imágenes borrosas en jugadas veloces, nuestros streams de deportes entregan fluidez absoluta de movimiento en 4K.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#0D0D14] border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-red-500/10 text-red-400 flex items-center justify-center mb-4">
              <ShieldCheck class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Anti-Freeze 9.2 con Caching Local</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Nuestra tecnología balancea dinámicamente las cargas entre 117 servidores para que ningún partido sufra de pantallas negras ni cortes de audio durante los penales o tiempos extra.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#0D0D14] border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center mb-4">
              <Tv class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Compatibilidad Total con Smart TV</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Disfruta en televisores Samsung Tizen, LG webOS, Amazon Fire TV Stick, Android TV, celulares y computadores. Con el plan anual te regalamos la licencia de la mejor app de reproducción.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Installation Steps & Reviews -->
    <ProcessSteps 
      title="Empieza a Ver el Partido en Menos de 3 Minutos"
      subtitle="Elige tu plan, recibe tus claves por WhatsApp y conéctate al instante en tu televisor."
    />

    <UserReviewsSection />

    <!-- Cities List (Geo Local SEO) -->
    <CitiesList 
      title="Servidores Locales para Ver Partidos en Todo Chile"
      subtitle="Menos de 15ms de latencia en Santiago, Valparaíso, Concepción, Antofagasta, Temuco y todo el territorio chileno."
    />

    <ContactForm 
      title="¿Tienes Preguntas Sobre la Cobertura de Tu Equipo?"
      subtitle="Consúltanos directamente por WhatsApp y te indicamos los canales exactos para el próximo partido."
    />

    <FAQSection />

    <CTASection 
      title="No Te Quedes Afuera del Próximo Partido: Activa Tu Cuenta 4K Ahora"
      description="Únete a miles de familias que ya ven todo el fútbol en vivo sin pagar los $60.000 mensuales del cable tradicional."
      buttonText="Contratar Plan Anual de Deportes ($35 USD)"
    />
  </main>

  <Footer />

  <FloatingWhatsApp />
  <SocialPopup />
  <GroupsPopup />
  <ExitPopup />
</Layout>

<!-- Client-side Real-Time Score Engine -->
<script is:inline>
  (function() {
    let currentLeague = 'chi.1';
    let currentFilter = 'all';
    let isFetching = false;
    let countdownSeconds = 30;
    let currentEvents = [];

    const grid = document.getElementById('matches-grid');
    const statusLabel = document.getElementById('live-api-status');
    const refreshBtn = document.getElementById('btn-refresh-scores');
    const refreshIcon = document.getElementById('refresh-icon');
    const countdownTimer = document.getElementById('countdown-timer');
    const countdownBar = document.getElementById('countdown-bar');
    const chileClock = document.getElementById('chile-clock');
    const leagueLabel = document.getElementById('current-league-label');
    const tabs = document.querySelectorAll('.league-tab');
    const filterPills = document.querySelectorAll('.filter-pill');

    const leagueNames = {
      'chi.1': 'Campeonato Chileno',
      'conmebol.libertadores': 'Copa Libertadores',
      'uefa.champions': 'UEFA Champions League',
      'esp.1': 'LaLiga Española',
      'eng.1': 'Premier League',
      'arg.1': 'Liga Profesional Argentina',
      'conmebol.sudamericana': 'Copa Sudamericana'
    };

    const leagueChannels = {
      'chi.1': 'Fútbol Chileno Prémium HD & 4K',
      'conmebol.libertadores': 'Copa Libertadores 4K UHD',
      'uefa.champions': 'Champions League en Vivo 4K',
      'esp.1': 'LaLiga en Directo HD',
      'eng.1': 'Premier League 4K UHD',
      'arg.1': 'Fútbol Argentino HD',
      'conmebol.sudamericana': 'Copa Sudamericana 4K'
    };

    // Live Chilean Clock
    function updateClock() {
      if (!chileClock) return;
      try {
        const now = new Date();
        chileClock.textContent = now.toLocaleTimeString('es-CL', { timeZone: 'America/Santiago', hour12: false });
      } catch (e) {
        chileClock.textContent = new Date().toLocaleTimeString();
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Render matches to DOM
    function renderMatches() {
      if (!grid) return;

      let filtered = currentEvents;
      if (currentFilter === 'live') {
        filtered = currentEvents.filter(ev => ev.state === 'in');
      } else if (currentFilter === 'today') {
        const todayStr = new Date().toDateString();
        filtered = currentEvents.filter(ev => {
          try {
            return new Date(ev.date).toDateString() === todayStr;
          } catch(e) { return true; }
        });
      } else if (currentFilter === 'upcoming') {
        filtered = currentEvents.filter(ev => ev.state === 'pre');
      }

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full text-center py-16 p-8 rounded-3xl bg-[#0D0D14] border border-white/10">
            <div class="w-12 h-12 rounded-2xl bg-white/5 text-slate-400 flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <circle cx="12" cy="12" r="10" stroke-width="2"/>
                <line x1="12" y1="8" x2="12" y2="12" stroke-width="2"/>
                <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/>
              </svg>
            </div>
            <h4 class="text-base font-bold text-white mb-1">No hay partidos en esta categoría</h4>
            <p class="text-xs text-slate-400 max-w-md mx-auto">
              Actualmente no se registran encuentros con este filtro para ${leagueNames[currentLeague] || 'este torneo'}. Prueba cambiando de torneo o seleccionando el filtro "Todos".
            </p>
          </div>
        `;
        return;
      }

      const channel = leagueChannels[currentLeague] || 'Señales Deportivas 4K';

      let html = '';
      filtered.forEach(ev => {
        let badgeClass = 'bg-blue-500/10 text-blue-400 border border-blue-500/20';
        let statusBadge = ev.statusText;

        if (ev.state === 'in') {
          badgeClass = 'bg-red-500/20 text-red-400 border border-red-500/40 animate-pulse';
          statusBadge = `🔴 EN VIVO ${ev.displayClock || ''}`;
        } else if (ev.state === 'post') {
          badgeClass = 'bg-white/5 text-slate-400 border border-white/10';
          statusBadge = 'FINALIZADO';
        }

        const whatsappMsg = encodeURIComponent(`Hola! Deseo activar iptv CHILE para ver el partido ${ev.homeName} vs ${ev.awayName} en directo en 4K.`);

        html += `
          <div class="match-card p-6 rounded-3xl bg-[#0D0D14] border border-white/10 hover:border-red-500/50 transition-all duration-300 flex flex-col justify-between group shadow-xl hover:-translate-y-1">
            <div>
              <div class="flex items-center justify-between text-xs font-bold text-slate-400 mb-4 pb-3 border-b border-white/5">
                <div class="flex items-center gap-1.5 min-w-0">
                  <span class="truncate text-slate-300">${ev.tournament}</span>
                </div>
                <span class="px-2.5 py-1 rounded-md font-mono text-[11px] font-bold ${badgeClass}">
                  ${statusBadge}
                </span>
              </div>

              <div class="space-y-4 mb-5">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3 min-w-0">
                    <img 
                      src="${ev.homeLogo}" 
                      alt="Escudo de ${ev.homeName}" 
                      width="32" 
                      height="32" 
                      class="w-8 h-8 object-contain shrink-0" 
                      onerror="this.style.opacity='0.2'"
                    />
                    <span class="text-base font-bold text-white truncate">${ev.homeName}</span>
                  </div>
                  <span class="font-mono text-2xl font-black text-white pl-3">${ev.homeScore}</span>
                </div>

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3 min-w-0">
                    <img 
                      src="${ev.awayLogo}" 
                      alt="Escudo de ${ev.awayName}" 
                      width="32" 
                      height="32" 
                      class="w-8 h-8 object-contain shrink-0" 
                      onerror="this.style.opacity='0.2'"
                    />
                    <span class="text-base font-bold text-white truncate">${ev.awayName}</span>
                  </div>
                  <span class="font-mono text-2xl font-black text-white pl-3">${ev.awayScore}</span>
                </div>
              </div>

              ${ev.venue ? `
                <p class="text-[11px] text-slate-400 mb-4 flex items-center gap-1.5 truncate">
                  <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                    <line x1="2" y1="12" x2="22" y2="12" stroke-width="2"/>
                  </svg>
                  <span class="truncate">${ev.venue}</span>
                </p>
              ` : ''}
            </div>

            <div>
              <div class="p-3 rounded-xl bg-white/5 border border-white/5 mb-4 flex items-center justify-between text-xs">
                <span class="flex items-center gap-1.5 text-emerald-400 font-semibold truncate">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <rect x="2" y="7" width="20" height="15" rx="2" ry="2" stroke-width="2"/>
                    <polyline points="17 2 12 7 7 2" stroke-width="2"/>
                  </svg>
                  <span class="truncate">${channel}</span>
                </span>
                <span class="font-mono font-bold text-slate-300 shrink-0 pl-2">${ev.detail}</span>
              </div>

              <a
                href="https://wa.me/213550592200?text=${whatsappMsg}"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 shadow-lg shadow-red-600/20 group-hover:scale-[1.02]"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                <span>Sintonizar en 4K sin Cortes</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <line x1="5" y1="12" x2="19" y2="12" stroke-width="2"/>
                  <polyline points="12 5 19 12 12 19" stroke-width="2"/>
                </svg>
              </a>
            </div>
          </div>
        `;
      });

      grid.innerHTML = html;
    }

    async function fetchScores(league) {
      if (isFetching || !grid) return;
      isFetching = true;
      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      if (statusLabel) statusLabel.textContent = 'Actualizando...';

      try {
        const res = await fetch(`https://site.api.espn.com/apis/site/v2/sports/soccer/${league}/scoreboard`, {
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok) throw new Error('Network error');
        const data = await res.json();
        const events = data.events || [];

        currentEvents = events.map(ev => {
          const comp = ev.competitions && ev.competitions[0];
          const home = (comp && comp.competitors && comp.competitors[0]) || {};
          const away = (comp && comp.competitors && comp.competitors[1]) || {};
          const status = ev.status || {};
          const statusType = status.type || {};
          const state = statusType.state || 'pre';
          const shortDetail = statusType.shortDetail || 'Programado';

          let statusText = shortDetail;
          if (state === 'in') {
            statusText = `EN VIVO ${status.displayClock || ''}`;
          } else if (state === 'post') {
            statusText = 'FINALIZADO';
          } else {
            try {
              const d = new Date(ev.date);
              statusText = d.toLocaleDateString('es-CL', { 
                weekday: 'short', 
                day: 'numeric', 
                month: 'short', 
                hour: '2-digit', 
                minute: '2-digit',
                timeZone: 'America/Santiago'
              });
            } catch(e) {
              statusText = shortDetail;
            }
          }

          return {
            tournament: (ev.league && ev.league.name) || ev.name?.split(' at ')[0] || leagueNames[league],
            homeName: home.team?.displayName || 'Local',
            homeLogo: home.team?.logo || 'https://a.espncdn.com/i/teamlogos/default-team-logo-500.png',
            homeScore: home.score || (state === 'pre' ? '-' : '0'),
            awayName: away.team?.displayName || 'Visita',
            awayLogo: away.team?.logo || 'https://a.espncdn.com/i/teamlogos/default-team-logo-500.png',
            awayScore: away.score || (state === 'pre' ? '-' : '0'),
            state: state,
            statusText: statusText,
            detail: shortDetail,
            displayClock: status.displayClock,
            date: ev.date,
            venue: comp?.venue?.fullName ? `${comp.venue.fullName}${comp.venue.address?.city ? `, ${comp.venue.address.city}` : ''}` : ''
          };
        });

        renderMatches();
        if (statusLabel) statusLabel.textContent = 'Actualizado en Vivo';

      } catch(err) {
        console.warn('Live score fetch failed:', err);
        if (statusLabel) statusLabel.textContent = 'En Espera';
      } finally {
        isFetching = false;
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        countdownSeconds = 30;
      }
    }

    // Tabs clicks
    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        const league = this.getAttribute('data-league');
        if (!league || league === currentLeague) return;

        tabs.forEach(t => {
          t.classList.remove('bg-red-600', 'text-white', 'shadow-lg', 'shadow-red-600/25', 'border-red-500/40');
          t.classList.add('bg-white/5', 'text-slate-300', 'border-white/5');
        });

        this.classList.add('bg-red-600', 'text-white', 'shadow-lg', 'shadow-red-600/25', 'border-red-500/40');
        this.classList.remove('bg-white/5', 'text-slate-300', 'border-white/5');

        currentLeague = league;
        if (leagueLabel) leagueLabel.textContent = leagueNames[league] || league;
        fetchScores(league);
      });
    });

    // Filter pills
    filterPills.forEach(pill => {
      pill.addEventListener('click', function() {
        const filter = this.getAttribute('data-filter');
        filterPills.forEach(p => {
          p.classList.remove('bg-white/10', 'text-white', 'border-white/20');
          p.classList.add('bg-white/5', 'text-slate-400', 'border-white/5');
        });
        this.classList.add('bg-white/10', 'text-white', 'border-white/20');
        this.classList.remove('bg-white/5', 'text-slate-400', 'border-white/5');

        currentFilter = filter;
        renderMatches();
      });
    });

    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => fetchScores(currentLeague));
    }

    // Countdown timer & auto-fetch
    setInterval(() => {
      countdownSeconds--;
      if (countdownTimer) countdownTimer.textContent = `${countdownSeconds}s`;
      if (countdownBar) {
        const pct = (countdownSeconds / 30) * 100;
        countdownBar.style.width = `${pct}%`;
      }
      if (countdownSeconds <= 0) {
        fetchScores(currentLeague);
      }
    }, 1000);

    // Initial load
    fetchScores(currentLeague);
  })();
</script>
