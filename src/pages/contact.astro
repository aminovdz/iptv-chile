---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ContactForm from '../components/ContactForm.astro';
import { MessageSquare, Mail, Send, MapPin, Clock, ShieldCheck, HelpCircle } from 'lucide-astro';
---

<Layout 
  title="Contacto y Soporte Técnico 24/7 | iptv CHILE"
  description="Contáctanos vía WhatsApp, Telegram o correo electrónico. Soporte técnico en vivo para activación inmediata de iptv CHILE, dudas de pago e instalación."
>
  <StickyHeader />

  <main>
    <!-- Contact Form & Direct Channels Component -->
    <ContactForm 
      title="Centro de Ayuda y Contacto Directo iptv CHILE"
      subtitle="Estamos disponibles 24/7 para asistirte en la activación de tu plan, renovación de cuentas o configuración técnica en tus Smart TV y dispositivos."
    />

    <!-- Supplemental Trust & SLA Section -->
    <section class="py-12 bg-[#040407] border-t border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          
          <div class="p-6 rounded-2xl bg-[#0D0D14] border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mx-auto mb-3">
              <Clock class="w-6 h-6" />
            </div>
            <h3 class="text-base font-bold text-white mb-1">Tiempo de Respuesta</h3>
            <p class="text-xs text-slate-300">
              Menos de <strong>2 minutos</strong> vía WhatsApp en horario extendido (08:00 a 02:00 hrs hora de Chile).
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#0D0D14] border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-red-500/10 text-red-400 flex items-center justify-center mx-auto mb-3">
              <MapPin class="w-6 h-6" />
            </div>
            <h3 class="text-base font-bold text-white mb-1">Presencia Nacional</h3>
            <p class="text-xs text-slate-300">
              Servidores CDN y asistencia técnica especializada para todas las regiones de Chile de Arica a Punta Arenas.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#0D0D14] border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center mx-auto mb-3">
              <ShieldCheck class="w-6 h-6" />
            </div>
            <h3 class="text-base font-bold text-white mb-1">Garantía Asegurada</h3>
            <p class="text-xs text-slate-300">
              Garantía de satisfacción y soporte guiado con instalación remota si la requieres.
            </p>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
