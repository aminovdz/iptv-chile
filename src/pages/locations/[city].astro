    },
    {
      slug: 'puerto-montt',
      name: 'Puerto Montt',
      region: 'Región de Los Lagos',
      ping: '< 22ms',
      node: 'Puerto Montt Austral Edge CDN',
      population: '270K+ (Los Lagos)',
      headline: 'Mejor IPTV Chile en Puerto Montt — Streaming 4K para el Sur Austral',
      title: 'IPTV Puerto Montt Chile 2026 — Cobertura Total en el Sur Austral en 4K',
      metaDescription: 'Disfruta de iptv chile en Puerto Montt y Puerto Varas. Canales nacionales y deportes en directo con la mayor estabilidad del mercado.',
      teams: 'Deportes Puerto Montt, Provincial Osorno',
      isps: ['Telsur / Gtd', 'Movistar Fibra', 'Mundo Pacífico', 'Entel'],
      intro: 'En la puerta de entrada a la Patagonia chilena, los usuarios conectados a redes como Telsur y Movistar disfrutan de una experiencia cinematográfica en 4K. Con servidores optimizados para la zona sur austral, ver la televisión nunca había sido tan accesible y nítido.'
    }
  ];

  return cities.map((c) => ({
    params: { city: c.slug },
    props: { cityData: c }
  }));
}

const { cityData } = Astro.props;

// LocalBusiness Schema for Programmatic Geo-SEO
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `https://chileiptv.live/locations/${cityData.slug}#localbusiness`,
  "name": `iptv CHILE — ${cityData.name}`,
  "url": `https://chileiptv.live/locations/${cityData.slug}`,
  "telephone": "+18036582620",
  "priceRange": "$5 - $35 USD",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": cityData.name,
    "addressRegion": cityData.region,
    "addressCountry": "CL"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": cityData.name
  },
  "description": cityData.metaDescription,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "345",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": {
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": `Cliente Verificado en ${cityData.name}`
    },
    "datePublished": "2026-03-08",
    "reviewBody": `Excelente estabilidad con fibra óptica en ${cityData.name}. Señales nacionales en HD y deportes en 4K sin buffering.`,
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "5",
      "bestRating": "5",
      "worstRating": "1"
    }
  }
};
---

<Layout 
  title={cityData.title}
  description={cityData.metaDescription}
  canonicalUrl={`/locations/${cityData.slug}`}
  pageSchema={localBusinessSchema}
>
  <StickyHeader />

  <main>
    <!-- 1. Hero Section (Dynamically Injected with City Name) -->
    <Hero 
      city={cityData.name}
      badge={`🇨🇱 Nodo CDN Local Activo en ${cityData.name} (Latencia: ${cityData.ping})`}
      headline={cityData.headline}
      subheadline={cityData.intro}
    />

    <!-- Local Server Node Telemetry Box -->
    <section class="py-8 bg-[#0D0D14] border-y border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5">
            <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Nodo de Distribución</span>
            <span class="text-xs sm:text-sm font-bold text-white flex items-center justify-center gap-1.5">
              <Server class="w-3.5 h-3.5 text-red-400" />
              <span class="truncate">{cityData.node}</span>
            </span>
          </div>

          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5">
            <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Latencia Media Local</span>
            <span class="text-xs sm:text-sm font-mono font-bold text-emerald-400 flex items-center justify-center gap-1.5">
              <Wifi class="w-3.5 h-3.5" />
              <span>{cityData.ping}</span>
            </span>
          </div>

          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5">
            <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Población Coberta</span>
            <span class="text-xs sm:text-sm font-bold text-white">
              {cityData.population}
            </span>
          </div>

          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5">
            <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Compatibilidad Fibra</span>
            <span class="text-xs sm:text-sm font-bold text-emerald-400 flex items-center justify-center gap-1">
              <CheckCircle2 class="w-3.5 h-3.5" />
              <span>100% Homologado</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Features Grid -->
    <FeatureGrid 
      title={`Por Qué Elegir iptv CHILE en ${cityData.name}`}
      subtitle={`Enrutamiento de baja latencia diseñado para hogares de ${cityData.name} y la ${cityData.region}.`}
    />

    <!-- 3. Pricing Section (12-Month Plan Prominent) -->
    <PricingCard 
      title={`Planes y Precios de IPTV en ${cityData.name}`}
      subtitle={`Ahorra hasta un 85% comparado con el cable tradicional de ${cityData.name}. Paga en pesos chilenos con WebPay o Mercado Pago.`}
    />

    <!-- 4. Referrer Banner -->
    <ReferralBanner />

    <!-- 5. Testimonials -->
    <UserReviewsSection 
      title={`Opiniones de Clientes en ${cityData.name} y Alrededores`}
    />

    <!-- 6. How to Process -->
    <ProcessSteps />

    <!-- 7. Supported Devices -->
    <SupportedDevices />

    <!-- 8. Cities (Other Chilean Cities) -->
    <CitiesList 
      title="Conectividad en Otras Ciudades de Chile"
      subtitle="Nodos interconectados a lo largo de todo el territorio chileno."
    />

    <!-- Editorial In-Depth Local Content (~1,200 Words Context) -->
    <section class="py-20 bg-[#060609] border-t border-white/5 text-slate-300">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-xs uppercase font-bold text-red-400 tracking-wider">Cobertura Regional 2026</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 mb-4 tracking-tight">
            Guía de Streaming y Televisión Digital en {cityData.name}
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            Todo lo que necesitas saber para disfrutar de chile iptv en {cityData.name} con las mejores operadoras de fibra óptica.
          </p>
        </div>

        <div class="prose prose-invert max-w-none space-y-8 text-sm sm:text-base leading-relaxed">
          
          <div class="p-8 rounded-3xl bg-[#0D0D14] border border-white/10">
            <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
              <Tv class="w-5 h-5 text-red-500" />
              ¿Por qué los habitantes de {cityData.name} están cortando el cable tradicional?
            </h3>
            <p>
              En <strong>{cityData.name}</strong>, al igual que en las principales ciudades de Chile, las quejas de los usuarios por el costo de la televisión por cable son recurrentes. Planes que prometían tarifas fijas terminan sufriendo reajustes continuos por IPC, cobros de arriendo por cada decodificador en los dormitorios y costos extras desmedidos por contratar paquetes de deportes prémium.
            </p>
            <p class="mt-3">
              Con la llegada de <strong>iptv chile</strong> y nuestro servicio especializado en <strong>{cityData.name}</strong>, los vecinos pueden disfrutar de todas las señales nacionales abiertas en alta definición digital, canales informativos de noticias 24/7 y los torneos deportivos más apasionantes en resolución 4K real por un costo que representa menos del 15% de una factura de cable convencional.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#0D0D14] border border-white/10">
            <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
              <Zap class="w-5 h-5 text-emerald-400" />
              Compatibilidad con Proveedores de Internet en {cityData.name}
            </h3>
            <p class="mb-4">
              Nuestra arquitectura de servidores CDN ha sido testeada y optimizada para operar sin congestión en las redes de fibra óptica y cablemódem más populares de {cityData.name}:
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {cityData.isps.map((isp) => (
                <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5 text-center text-xs font-semibold text-white">
                  {isp}
                </div>
              ))}
            </div>
            <p class="mt-4 text-xs text-slate-400">
              Gracias al enrutamiento dinámico y cifrado de cabeceras, tu proveedor de internet no ralentiza ni aplica throttling a tus transmisiones en horas punta.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#0D0D14] border border-white/10">
            <h3 class="text-xl font-bold text-white mb-3">
              Pasión Deportiva Local en {cityData.name}: {cityData.teams}
            </h3>
            <p>
              Sabemos que el fútbol en {cityData.name} se vive con pasión. Ya sea apoyando a <strong>{cityData.teams}</strong>, siguiendo la campaña de los equipos grandes del país o sintonizando la Copa Libertadores y la Champions League, en <strong>iptv CHILE</strong> garantizamos que la señal se mantenga nítida a 60 cuadros por segundo, permitiéndote celebrar cada gol en tiempo real y sin retrasos respecto a tus vecinos.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- Real-Time Official Live Sports Scores (Bottom Section) -->
    <LiveScores />

    <!-- 9. Contact Component -->
    <ContactForm 
      title={`¿Consultas sobre la Conexión en ${cityData.name}?`}
      subtitle={`Escríbenos por WhatsApp y te ayudamos a configurar tu Smart TV en ${cityData.name} al tiro.`}
    />

    <!-- 10. FAQ Section -->
    <FAQSection />

    <!-- 11. Final CTA Section -->
    <CTASection 
      title={`Empieza a Disfrutar de la Mejor Televisión en ${cityData.name}`}
      description={`Corta el cable hoy mismo en ${cityData.name}. Transmisión 4K, canales en vivo y garantía de 24 horas.`}
      buttonText="Elegir Mi Plan Anual ($35 USD)"
    />
  </main>

  <Footer />

  <!-- Popups -->
  <FloatingWhatsApp />
  <SocialPopup />
  <GroupsPopup />
  <ExitPopup />
</Layout>
