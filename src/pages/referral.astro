---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { Gift, Share2, Users, Sparkles, ArrowRight, CheckCircle2, ShieldCheck, MessageSquare } from 'lucide-astro';
---

<Layout 
  title="Programa de Referidos | Gana Meses Gratis en iptv CHILE"
  description="Recomienda iptv CHILE a tus amigos y familiares en Chile y gana 1 mes gratis de streaming 4K por cada referido sin límite de recompensas."
>
  <StickyHeader />

  <main class="py-16 sm:py-24 bg-[#060609] relative overflow-hidden">
    <!-- Ambient Glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-amber-500/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Top Title -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
          <Gift class="w-3.5 h-3.5" />
          <span>Multiplica Tu Entretenimiento Gratis</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
          Programa de Referidos iptv CHILE
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Comparte la mejor televisión en vivo con tus amigos y familiares en Chile. Por cada persona que contrate un plan, ambos ganan beneficios exclusivos.
        </p>
      </div>

      <!-- Hero Card Explaining Benefits -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        <div class="p-8 rounded-3xl bg-gradient-to-br from-[#131322] to-[#0A0D18] border border-amber-500/30 text-left relative overflow-hidden">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mb-4">
            <Gift class="w-6 h-6" />
          </div>
          <span class="text-xs uppercase font-bold text-amber-400 tracking-wider">Tu Beneficio</span>
          <h2 class="text-2xl font-black text-white mt-1 mb-2">1 Mes Gratis por Cada Amigo</h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Sin límites: si refieres a 12 personas, ¡tienes un año entero de servicio 4K gratis! El mes se añade de inmediato a tu suscripción vigente.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-gradient-to-br from-[#131322] to-[#0A0D18] border border-blue-500/30 text-left relative overflow-hidden">
          <div class="w-12 h-12 rounded-2xl bg-blue-500/20 text-blue-400 flex items-center justify-center mb-4">
            <Users class="w-6 h-6" />
          </div>
          <span class="text-xs uppercase font-bold text-blue-400 tracking-wider">El Beneficio de Tu Amigo</span>
          <h2 class="text-2xl font-black text-white mt-1 mb-2">10% de Descuento Inmediato</h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Tu referido obtiene un 10% de rebaja en su primera contratación, además de soporte asistido por WhatsApp y activación al tiro.
          </p>
        </div>
      </div>

      <!-- How it Works 3 Steps -->
      <div class="p-8 sm:p-12 rounded-3xl bg-[#0D0D14] border border-white/10 mb-16">
        <h3 class="text-2xl font-bold text-white text-center mb-10">¿Cómo Funciona el Programa?</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
          <div>
            <span class="text-3xl font-black text-amber-400 font-mono block mb-2">Paso 1</span>
            <h4 class="text-base font-bold text-white mb-2">Pide Tu Código de Referido</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Escríbenos a nuestro WhatsApp oficial con tu número de cuenta y te entregaremos tu enlace o código personalizado al instante.
            </p>
          </div>

          <div>
            <span class="text-3xl font-black text-amber-400 font-mono block mb-2">Paso 2</span>
            <h4 class="text-base font-bold text-white mb-2">Compártelo con Tus Conocidos</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Envíalo por WhatsApp, redes sociales o recomiéndalo a amigos hinchas del fútbol que estén cansados de pagar las cuentas caras del cable.
            </p>
          </div>

          <div>
            <span class="text-3xl font-black text-amber-400 font-mono block mb-2">Paso 3</span>
            <h4 class="text-base font-bold text-white mb-2">Recibe Tus Días en 4K</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              En cuanto tu amigo active su plan, nuestro sistema sumará automáticamente 30 días gratuitos a la fecha de término de tu cuenta.
            </p>
          </div>
        </div>

        <!-- Action Generator -->
        <div class="mt-12 pt-8 border-t border-white/10 text-center">
          <a 
            href="https://wa.me/18036582620?text=Hola!%20Soy%20cliente%20de%20iptv%20CHILE%20y%20deseo%20activar%20mi%20código%20del%20Programa%20de%20Referidos."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl bg-gradient-to-r from-amber-500 to-red-600 hover:from-amber-400 hover:to-red-500 text-white font-extrabold text-sm shadow-xl shadow-amber-600/30 transition-all hover:scale-105"
          >
            <Share2 class="w-4 h-4" />
            <span>Solicitar Mi Código por WhatsApp Ahora</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
