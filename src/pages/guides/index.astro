---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { getCollection } from 'astro:content';
import { BookOpen, Calendar, Clock, ChevronRight, Sparkles, ShieldCheck, Tag } from 'lucide-astro';

const allGuides = await getCollection('guides');
const sortedGuides = allGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "Guías, Tutoriales y Análisis Técnico de IPTV en Chile | Blog Oficial";
const description = "Aprende a configurar tu Smart TV Samsung, LG o Firestick, conoce el marco legal en Chile (Subtel) y descubre comparativas para ver televisión sin cortes.";
---

<Layout title={title} description={description}>
  <StickyHeader />

  <main class="min-h-screen pt-28 pb-20 bg-slate-950 text-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-slate-200">Guías y Tutoriales</span>
      </nav>

      <!-- Hero Section -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold mb-4">
          <BookOpen class="w-3.5 h-3.5" />
          <span>Centro de Aprendizaje y Soporte Técnico</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Guías y Tutoriales <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-primary to-blue-500">IPTV Chile</span>
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Manuales paso a paso redactados por ingenieros de telecomunicaciones locales. Aprende a instalar en cualquier pantalla, optimizar tu conexión de fibra óptica y resolver dudas sobre la normativa chilena.
        </p>
      </div>

      <!-- Featured or First Guide Card -->
      {sortedGuides.length > 0 && (
        <section class="mb-16">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-6 flex items-center gap-2">
            <Sparkles class="w-4 h-4 text-amber-400" />
            <span>Artículo Destacado</span>
          </h2>
          {(() => {
            const featured = sortedGuides.find(g => g.data.featured) || sortedGuides[0];
            return (
              <div class="glass-card rounded-3xl p-6 sm:p-10 border border-white/10 hover:border-primary/40 transition-all duration-300 relative overflow-hidden group">
                <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none group-hover:bg-primary/20 transition-all"></div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                  <div class="lg:col-span-8 space-y-4">
                    <div class="flex flex-wrap items-center gap-3 text-xs">
                      <span class="px-3 py-1 rounded-full bg-primary/20 text-primary-light font-medium border border-primary/30">
                        {featured.data.category}
                      </span>
                      <span class="flex items-center gap-1 text-slate-400">
                        <Calendar class="w-3.5 h-3.5" />
                        {featured.data.pubDate.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </span>
                      <span class="flex items-center gap-1 text-slate-400">
                        <Clock class="w-3.5 h-3.5" />
                        7 min de lectura
                      </span>
                    </div>

                    <h3 class="text-2xl sm:text-3xl font-bold text-white group-hover:text-primary-light transition-colors leading-snug">
                      <a href={`/guides/${featured.slug}/`}>
                        {featured.data.title}
                      </a>
                    </h3>

                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed line-clamp-3">
                      {featured.data.description}
                    </p>

                    <div class="flex flex-wrap items-center gap-2 pt-2">
                      {featured.data.tags.slice(0, 3).map(tag => (
                        <span class="text-xs px-2.5 py-0.5 rounded-md bg-white/5 border border-white/10 text-slate-400">
                          #{tag}
                        </span>
                      ))}
                    </div>

                    <div class="pt-4">
                      <a
                        href={`/guides/${featured.slug}/`}
                        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-sm transition-all shadow-lg shadow-primary/25"
                      >
                        <span>Leer Guía Completa</span>
                        <ChevronRight class="w-4 h-4" />
                      </a>
                    </div>
                  </div>

                  <div class="lg:col-span-4 bg-slate-900/60 rounded-2xl p-6 border border-white/5 space-y-4 text-xs text-slate-300">
                    <div class="flex items-center gap-2 text-white font-semibold text-sm">
                      <ShieldCheck class="w-4 h-4 text-emerald-400" />
                      <span>Verificado por Expertos</span>
                    </div>
                    <p>
                      Contenido elaborado con apego estricto a las especificaciones de la Subsecretaría de Telecomunicaciones (Subtel) y estándares de redes IP chilenas.
                    </p>
                    <div class="border-t border-white/5 pt-3">
                      <span class="text-slate-400">Autor:</span> <strong class="text-white">{featured.data.author}</strong>
                    </div>
                  </div>
                </div>
              </div>
            );
          })()}
        </section>
      )}

      <!-- All Guides Grid -->
      <section>
        <h2 class="text-xl font-bold text-white mb-8 flex items-center gap-2">
          <span>Todas las Guías y Manuales</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedGuides.map((guide) => (
            <article class="glass-card rounded-2xl overflow-hidden border border-white/10 hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group">
              <a href={`/guides/${guide.slug}/`} class="block overflow-hidden aspect-video bg-slate-900 border-b border-white/5">
                <img 
                  src={guide.data.heroImage || '/images/og-chile-iptv.jpg'} 
                  alt={guide.data.heroImageAlt || guide.data.title}
                  width="600"
                  height="338"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </a>
              <div class="p-6 space-y-3 flex-1 flex flex-col justify-between">
                <div class="space-y-3">
                  <div class="flex items-center justify-between text-xs text-slate-400">
                    <span class="px-2.5 py-0.5 rounded-md bg-white/5 border border-white/10 text-primary-light font-medium">
                      {guide.data.category}
                    </span>
                    <span class="flex items-center gap-1">
                      <Calendar class="w-3 h-3" />
                      {guide.data.pubDate.toLocaleDateString('es-CL', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </span>
                  </div>

                  <h3 class="text-lg font-bold text-white group-hover:text-primary-light transition-colors leading-snug">
                    <a href={`/guides/${guide.slug}/`}>
                    {guide.data.title}
                  </a>
                </h3>

                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed line-clamp-3">
                  {guide.data.description}
                </p>
              </div>

              <div class="pt-6 mt-6 border-t border-white/5 flex items-center justify-between">
                <div class="flex items-center gap-1 text-xs text-slate-400">
                  <Tag class="w-3 h-3 text-slate-500" />
                  <span>{guide.data.tags[0] || 'Guía'}</span>
                </div>
                <a
                  href={`/guides/${guide.slug}/`}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:text-primary-light transition-colors"
                >
                  <span>Leer tutorial</span>
                  <ChevronRight class="w-3.5 h-3.5" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Banner CTA -->
      <div class="mt-20 glass-card rounded-3xl p-8 sm:p-12 border border-primary/30 text-center relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto space-y-4">
          <h2 class="text-2xl sm:text-4xl font-black text-white">¿Tienes dudas con la instalación en tu televisor?</h2>
          <p class="text-slate-300 text-sm sm:text-base">
            No te compliques. Nuestro equipo técnico de soporte te asiste en vivo paso a paso por WhatsApp para dejar tu pantalla funcionando en 5 minutos.
          </p>
          <div class="pt-4 flex flex-wrap justify-center gap-4">
            <a
              href="https://wa.me/18036582620?text=Hola,%20vi%20las%20guías%20en%20la%20web%20y%20necesito%20ayuda%20para%20instalar%20en%20mi%20Smart%20TV"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-emerald-500/20"
            >
              Pedir Ayuda por WhatsApp
            </a>
            <a
              href="/#precios"
              class="px-8 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 transition-all"
            >
              Ver Planes y Precios
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>
