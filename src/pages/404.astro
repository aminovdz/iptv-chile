---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { Home, Sparkles, MessageSquare, ArrowRight, AlertTriangle } from 'lucide-astro';
---

<Layout 
  title="Página No Encontrada (Error 404) | iptv CHILE"
  description="La página que buscas no existe o ha sido trasladada. Vuelve al inicio de iptv CHILE o contacta a soporte por WhatsApp."
>
  <StickyHeader />

  <main class="min-h-[70vh] flex items-center justify-center py-20 bg-[#060609] relative overflow-hidden">
    <!-- Glow -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-red-600/15 rounded-full blur-[140px]"></div>
    </div>

    <div class="max-w-xl mx-auto px-4 text-center relative z-10">
      
      <!-- 404 Number -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-6">
        <AlertTriangle class="w-3.5 h-3.5" />
        <span>Error 404 — Señal Fuera de Aire</span>
      </div>

      <h1 class="text-7xl sm:text-9xl font-black text-white tracking-tighter mb-4 font-mono text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-white to-blue-500">
        404
      </h1>

      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3 tracking-tight">
        ¡Ups! Esta señal no está disponible
      </h2>

      <p class="text-slate-300 text-sm mb-8 leading-relaxed">
        La página que intentas sintonizar ha cambiado de frecuencia, se ha movido o no existe en nuestra red de iptv CHILE. No te preocupes, puedes volver a la transmisión principal.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/" 
          class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-sm shadow-xl shadow-red-600/30 transition-all flex items-center justify-center gap-2 hover:scale-105"
        >
          <Home class="w-4 h-4" />
          <span>Volver al Inicio</span>
        </a>

        <a 
          href="/#precios" 
          class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-white/5 hover:bg-white/10 text-white font-bold text-sm border border-white/10 hover:border-red-500/40 transition-all flex items-center justify-center gap-2"
        >
          <Sparkles class="w-4 h-4 text-yellow-400" />
          <span>Ver Planes de IPTV</span>
        </a>
      </div>

    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
